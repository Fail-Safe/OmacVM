# OmacVM.app: build OmacVM's virtio-gpu driver for new kernels (loaded from the
# next start; until it is built the stock one loads); a failed build never
# fails the update.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = linux-aarch64
Target = linux-aarch64-headers
Target = linux-aarch64-thp
Target = linux-aarch64-thp-headers

[Action]
Description = OmacVM: virtio-gpu driver for the new kernel
When = PostTransaction
Exec = /usr/local/lib/omacvm/virtio-gpu/omacvm-virtio-gpu-build --hook

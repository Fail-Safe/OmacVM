# OmacVM.app: build OmacVM's virtio-gpu driver for new kernels (it stays
# dormant until one of the app's switches starts the VM); a failed build
# never fails the update.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = linux-aarch64
Target = linux-aarch64-headers
Target = linux-aarch64-thp
Target = linux-aarch64-thp-headers

[Action]
Description = OmacVM: virtio-gpu driver for the new kernel
When = PostTransaction
Exec = /usr/local/lib/omacvm/virtio-gpu/omacvm-virtio-gpu-build --hook

#!/bin/bash
# OmacVM.app: the guest's virtio-gpu driver with two module options:
# deep_color (10-bit scanout formats for HDR, linux-virtio-gpu-deep-color.patch)
# and cursor_plane (the pointer on its own layer,
# linux-virtio-gpu-cursor-plane.patch), and Linux 7.4's damage fix
# (linux-virtio-gpu-damage-clips.patch, only on a kernel without it): the
# compositor's damage reaches QEMU, which then redraws only what changed.
# Without the options it is the stock driver plus that fix. Built for each
# kernel into /usr/local/lib/omacvm/virtio-gpu/<kernel>/, where depmod does
# not see it. The modprobe rule written here hands virtio_gpu to
# omacvm-virtio-gpu-load, which loads it only for a start with one of the
# app's switches on (it asks over SMBIOS), else the stock one.
# omacvm apply runs this on every app VM, the pacman hook after
# kernel updates. Needs the kernel's headers. The driver's sources are the
# upstream stable release of the kernel's version, from kernel.org; download,
# patch and build run as a user id of their own (no account, nothing else
# runs as it), root only installs the result.
# Usage (root):
#   omacvm-virtio-gpu-build             build for the running kernel
#   omacvm-virtio-gpu-build --kernel K  build for kernel K
#   omacvm-virtio-gpu-build --hook      every installed kernel with headers;
#                                       drops the builds of removed kernels
#   omacvm-virtio-gpu-build --status    one line: built for the running kernel
#                                       or why not (exit 1), and this start's driver
#   omacvm-virtio-gpu-build --remove    the builds and the modprobe rule go
# A kernel without headers is skipped; a build whose stamp (the patches'
# sha256 and the kernel) is current is not built again. Deep colour is the
# base; the cursor plane and the damage fix go on top: one
# that does not apply or build on a kernel is left out of that kernel's build
# (its file "without" and --status say which), and the others stay.
set -euo pipefail
# Tests only: a made-up file system under this folder, stand-ins on the PATH.
P=${OMACVM_VIRTIO_GPU_TEST_ROOT:-}
self=$(readlink -f "$0")
root=$P/usr/local/lib/omacvm/virtio-gpu
mods=$P/lib/modules
rule=$P/etc/modprobe.d/omacvm-virtio-gpu.conf
patch_file=$root/linux-virtio-gpu-deep-color.patch
cursor_file=$root/linux-virtio-gpu-cursor-plane.patch
damage_file=$root/linux-virtio-gpu-damage-clips.patch
# The build's own user id: no account, no other process runs as it (nobody
# is shared by other services, which could change the sources mid-build).
builder=64917
budget=300   # seconds for all builds of one run: the pacman hook holds kernel updates
work="" stage=""
trap 'rm -rf ${work:+"$work"} ${stage:+"$stage"}' EXIT

say() { echo "omacvm-virtio-gpu: $*"; }

stamp_for() { echo "$(cat "$patch_file" "$cursor_file" "$damage_file" 2>/dev/null | sha256sum 2>/dev/null | cut -d' ' -f1) $1"; }

current() {   # KERNEL: built, and from this patch
  [[ -f $root/$1/virtio-gpu.ko && $(cat "$root/$1/stamp" 2>/dev/null) == "$(stamp_for "$1")" ]]
}

failed() {   # KERNEL WHY: said, and kept for --status
  say "$1: not built: $2"
  { mkdir -p "$root/$1" && printf '%s\n' "$2" > "$root/$1/error"; } 2>/dev/null || true
}

# As the build's own user id, in its own WORK folder: fetch, patch, build. The module goes to
# stdout, everything else to stderr.
fetch_and_make() {   # KERNEL VERSION WORK
  local kernel=$1 version=$2 src=$3/drivers/gpu/drm/virtio f
  local base=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/gpu/drm/virtio
  exec 3>&1 1>&2
  mkdir -p "$src"
  for f in Makefile virtgpu_debugfs.c virtgpu_display.c virtgpu_drv.c virtgpu_drv.h \
           virtgpu_fence.c virtgpu_gem.c virtgpu_ioctl.c virtgpu_kms.c virtgpu_object.c \
           virtgpu_plane.c virtgpu_prime.c virtgpu_submit.c virtgpu_trace.h \
           virtgpu_trace_points.c virtgpu_vq.c virtgpu_vram.c; do
    curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
      --connect-timeout 10 --max-time 60 --retry 2 -o "$src/$f" "$base/$f?h=v$version"
  done
  cp -R "$3/drivers" "$3/stock"
  # Deep colour (HDR) is the base. On top, in this order: the cursor plane
  # (experimental) and Linux 7.4's damage fix (only on a kernel with the line
  # it replaces).
  # One that does not apply or build is left out and said (for --status and
  # the loader), so a newer kernel never takes HDR or the others down with it.
  local -a use=("$patch_file") left=() try
  local p q i damage built=""
  tree "$3" "${use[@]}" || { echo "omacvm-virtio-gpu: no build: deep_color does not apply to $version"; return 1; }
  # The line Linux 7.4's fix replaces (ours goes on), or the line it puts in
  # (the kernel's own); neither: not known, so ours stays out.
  if grep -q 'new_plane_state->ignore_damage_clips = true;' "$src/virtgpu_plane.c"; then damage=ours
  elif grep -q 'new_plane_state->fb && bo->dumb;' "$src/virtgpu_plane.c"; then damage=kernel
  else
    damage=unknown
    left+=("damage_clips: $version's virtgpu_plane.c has neither the line it replaces nor Linux 7.4's fix")
  fi
  for p in "$cursor_file" "$damage_file"; do
    [[ $p != "$damage_file" || $damage == ours ]] || continue
    if tree "$3" "${use[@]}" "$p"; then use+=("$p")
    else left+=("$(option_of "$p"): $(option_of "$p") does not apply to $version"); fi
  done
  # All that apply; when that build fails, without one extra patch at a time
  # (the last first), then deep colour alone.
  if make_with "$kernel" "$3" "${use[@]}"; then built=1
  else
    for (( i = ${#use[@]} - 1; i >= 1; i-- )); do
      p=${use[i]} try=()
      for q in "${use[@]}"; do
        [[ $q == "$p" ]] || try+=("$q")
      done
      make_with "$kernel" "$3" "${try[@]}" || continue
      left+=("$(option_of "$p"): $(option_of "$p") does not build on $version")
      use=("${try[@]}") built=1
      break
    done
  fi
  if [[ -z $built ]] && (( ${#use[@]} > 2 )) && make_with "$kernel" "$3" "$patch_file"; then
    for p in "${use[@]:1}"; do
      left+=("$(option_of "$p"): left out, the build on $version failed with two or more of the extra patches")
    done
    use=("$patch_file") built=1
  fi
  [[ -n $built ]] || { echo "omacvm-virtio-gpu: no build: deep_color does not build on $version"; return 1; }
  for p in ${left[@]+"${left[@]}"}; do echo "omacvm-virtio-gpu: built without $p"; done
  # The word goes as it is into the build's file "damage" (the loader and
  # omacvm check read it): ours, kernel (the kernel's own), unknown.
  if [[ $damage != ours ]]; then echo "omacvm-virtio-gpu: damage fix: $damage"
  elif [[ " ${use[*]} " == *" $damage_file "* ]]; then echo "omacvm-virtio-gpu: damage fix: ours"; fi
  cat "$src/virtio-gpu.ko" >&3
}

make_with() {   # KERNEL WORK PATCH...: those patches on the stock sources, built; 1 if one does not apply or it does not build
  local kernel=$1 src=$2/drivers/gpu/drm/virtio
  shift
  tree "$@" || return 1
  # Out of tree: the trace header sits next to the sources.
  sed -i 's|^#define TRACE_INCLUDE_PATH .*|#define TRACE_INCLUDE_PATH .|' "$src/virtgpu_trace.h"
  echo 'CFLAGS_virtgpu_trace_points.o := -I$(src)' >> "$src/Makefile"
  make -s -j"$(nproc)" -C "$mods/$kernel/build" M="$src" CONFIG_DRM_VIRTIO_GPU=m modules
}

tree() {   # WORK PATCH...: the stock sources again, these patches on them; 1 if one does not apply
  local w=$1 p; shift
  rm -rf "$w/drivers" && cp -R "$w/stock" "$w/drivers" || return 1
  # No fuzz: each hunk's context must fit exactly (a shift in lines is fine).
  # With patch's default fuzz a hunk can land in the wrong place of a newer
  # kernel and still build; this way it does not apply, and the patch is left out.
  # Each hunk needs as many context lines before its change as after: GNU
  # patch with -F 0 pins an uneven hunk to the start or end of the file
  # (src/tests/virtio-gpu-patches.sh checks it).
  for p; do patch -s -d "$w" -p1 -f -F 0 -i "$p" || return 1; done
}

option_of() {   # PATCH FILE: its name in the build's "without" list
  case $1 in
    "$cursor_file") echo cursor_plane ;;
    "$damage_file") echo damage_clips ;;
    *) echo deep_color ;;
  esac
}

build() {   # KERNEL: 0 = built, current or no headers; 1 = failed
  local kernel=$1 version left rc=0 v keep why
  if [[ ! $kernel =~ ^[A-Za-z0-9._+-]+$ || $kernel == .* ]]; then
    say "not a kernel name: $kernel"; return 1
  fi
  if [[ ! -d $mods/$kernel/build ]]; then
    say "$kernel: no kernel headers ($mods/$kernel/build), skipped"; return 0
  fi
  if current "$kernel"; then say "$kernel: up to date"; return 0; fi
  version=${kernel%%-*}
  [[ $version =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || { failed "$kernel" "unexpected kernel version"; return 1; }
  if [[ $version == *.*.0 ]]; then version=${version%.0}; fi   # tag v7.2, not v7.2.0
  [[ -f $patch_file && -f $cursor_file && -f $damage_file ]] ||
    { failed "$kernel" "no $patch_file, $cursor_file or $damage_file"; return 1; }
  left=$((budget - SECONDS))
  (( left > 10 )) || { failed "$kernel" "no time left in this run (${budget} s for all kernels)"; return 1; }
  if ! { work=$(mktemp -d "$P/tmp/omacvm-virtio-gpu.XXXXXX") && stage=$(mktemp -d "$P/tmp/omacvm-virtio-gpu.XXXXXX") &&
         chown "$builder:$builder" "$work"; }; then
    failed "$kernel" "no work folder for the build"; return 1
  fi
  # A clean environment, but the proxy (the Mac's, from the build) stays.
  keep=(PATH=/usr/local/bin:/usr/bin:/bin "HOME=$work" LC_ALL=C)
  for v in http_proxy https_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY; do
    [[ -z ${!v:-} ]] || keep+=("$v=${!v}")
  done
  timeout --kill-after=10 "$left" setpriv --reuid="$builder" --regid="$builder" --clear-groups --no-new-privs -- \
    env -i "${keep[@]}" "$self" --unprivileged "$kernel" "$version" "$work" \
    > "$stage/virtio-gpu.ko" 2> "$stage/log" || rc=$?
  if (( rc != 0 )); then
    cat "$stage/log" >&2
    why=$(grep -v '^[[:space:]]*$' "$stage/log" | tail -n1 | cut -c1-200) || true
    (( rc != 124 && rc != 137 )) || why="timed out after $left s"
    failed "$kernel" "${why:-exit $rc}"
  elif [[ $(modinfo -F vermagic "$stage/virtio-gpu.ko" 2>/dev/null) != "$kernel "* ]]; then
    failed "$kernel" "the build is not a module for $kernel"; rc=1
  # The stamp last: a module without its stamp is never loaded.
  # What the build left out (a patch that does not fit this kernel) and whose
  # damage fix it has ("ours", "kernel", "unknown"): kept for --status, the loader, omacvm check.
  elif ! { install -d -o root -g root -m 0755 "$root/$kernel" &&
           rm -f "$root/$kernel/stamp" "$root/$kernel/error" "$root/$kernel/without" "$root/$kernel/damage" &&
           install -o root -g root -m 0644 "$stage/virtio-gpu.ko" "$root/$kernel/virtio-gpu.ko" &&
           { sed -n 's/^omacvm-virtio-gpu: built without //p' "$stage/log" > "$stage/without"; true; } &&
           { [[ ! -s $stage/without ]] || install -o root -g root -m 0644 "$stage/without" "$root/$kernel/without"; } &&
           { sed -n 's/^omacvm-virtio-gpu: damage fix: //p' "$stage/log" > "$stage/damage"; true; } &&
           { [[ ! -s $stage/damage ]] || install -o root -g root -m 0644 "$stage/damage" "$root/$kernel/damage"; } &&
           stamp_for "$kernel" | install -o root -g root -m 0644 /dev/stdin "$root/$kernel/stamp"; }; then
    failed "$kernel" "could not install it into $root/$kernel"; rc=1
  else
    say "$kernel: built (loaded only when one of the app's switches starts the VM)"
    while IFS= read -r v; do say "$kernel: without $v"; done < "$stage/without"
    case $(cat "$stage/damage") in
      kernel) say "$kernel: the damage fix is the kernel's own" ;;
      unknown) say "$kernel: not known whether the kernel keeps the damage (no damage fix added)" ;;
    esac
  fi
  rm -rf "$work" "$stage"; work="" stage=""
  return $(( rc != 0 ))
}

# The by-hand install of earlier versions went into /lib/modules/K/updates,
# where it was always loaded: it goes.
migrate() {
  local f k
  for f in "$mods"/*/updates/virtio-gpu.ko; do
    [[ -e $f ]] || continue
    k=${f#"$mods"/}; k=${k%%/*}
    rm -f "$f"
    depmod -a "$k" 2>/dev/null || true
    say "$k: removed the build in updates/ (by hand, always loaded)"
  done
  rm -f "$P/etc/omacvm/virtio-gpu-deep-color"
}

rule_text() {
  cat <<'EOF'
# OmacVM.app (omacvm-virtio-gpu-build): virtio_gpu goes through
# omacvm-virtio-gpu-load, which loads OmacVM's driver only for a start with
# one of the app's switches on (10-bit colour, the pointer on its own
# layer, draw only what changed), else the stock
# one (and the stock one if it fails). In the initramfs (no loader there;
# mkinitcpio's kms hook puts virtio_gpu in it) such a start loads nothing yet:
# udev loads it again from the real root, through the loader. Every other
# start: the stock one, as before.
install virtio_gpu if [ -x /usr/local/lib/omacvm/virtio-gpu/omacvm-virtio-gpu-load ]; then /usr/local/lib/omacvm/virtio-gpu/omacvm-virtio-gpu-load $CMDLINE_OPTS || /sbin/modprobe --ignore-install virtio_gpu $CMDLINE_OPTS; elif grep -qs -e omacvm.deepcolor=1 -e omacvm.hdr=1 -e omacvm.pointerplane=2 -e omacvm.damage=1 /sys/firmware/dmi/entries/11-*/raw; then :; else /sbin/modprobe --ignore-install virtio_gpu $CMDLINE_OPTS; fi
EOF
}

# The modprobe rule, once a build for some kernel is there.
write_rule() {
  local d
  for d in "$root"/*/; do
    if [[ ! -d $d ]] || ! current "$(basename "$d")"; then continue; fi
    [[ $(rule_text) == "$(cat "$rule" 2>/dev/null)" ]] && return 0
    mkdir -p "${rule%/*}"
    rule_text > "$rule.tmp" && chmod 644 "$rule.tmp" && mv -f "$rule.tmp" "$rule"
    return 0
  done
}

# An initramfs made before the rule (or before it changed) that has
# virtio_gpu in it loads the stock driver at boot: made again, once
# (mkinitcpio -P; a kernel update makes them anyway, after this rule).
refresh_initramfs() {
  local img stale=""
  [[ -f $rule ]] || return 0
  for img in "$P"/boot/initramfs-*.img; do
    [[ -f $img && $img -ot $rule ]] || continue
    lsinitcpio "$img" 2>/dev/null | grep -q 'virtio.gpu' && stale=1
  done
  [[ -n $stale ]] || return 0
  say "the initramfs has virtio_gpu but not the rule yet: mkinitcpio -P"
  timeout 300 mkinitcpio -P > "$P/var/log/omacvm-virtio-gpu-mkinitcpio.log" 2>&1 ||
    say "mkinitcpio -P failed (log: /var/log/omacvm-virtio-gpu-mkinitcpio.log); the stock driver loads at boot until the next one"
}

status() {
  local k now why
  k=$(uname -r)
  now=$(cat "$P/run/omacvm/virtio-gpu" 2>/dev/null) || now="stock, loaded without omacvm-virtio-gpu-load"
  if current "$k"; then
    why=$(paste -sd';' "$root/$k/without" 2>/dev/null) || true
    echo "built for $k${why:+ without ${why//;/; without }} (this start: $now)"; return 0
  fi
  if [[ ! -d $mods/$k/build ]]; then why="no kernel headers"
  elif [[ -s $root/$k/error ]]; then why="build failed: $(head -n1 "$root/$k/error")"
  elif [[ -f $root/$k/virtio-gpu.ko ]]; then why="out of date (another patch)"
  else why="not built yet"; fi
  echo "not built for $k: $why (this start: $now)"
  return 1
}

case ${1:-} in
  --status|--unprivileged) ;;
  *) [[ $EUID == 0 || -n $P ]] || { echo "omacvm-virtio-gpu: run as root" >&2; exit 2; } ;;
esac
case ${1:-} in
  --status)
    status
    ;;
  --remove)
    migrate
    for d in "$root"/*/; do [[ -d $d ]] && rm -rf "$d"; done
    rm -f "$rule"
    say "removed; the stock driver loads at the next start"
    ;;
  --hook)
    migrate
    for d in "$mods"/*/; do
      # Only installed kernels: headers can outlive their kernel for a while.
      [[ -d $d && -d $d/kernel ]] && build "$(basename "$d")" || true
    done
    for d in "$root"/*/; do
      [[ -d $d ]] || continue
      k=$(basename "$d")
      [[ -d $mods/$k/kernel ]] || { rm -rf "$d"; say "$k: removed (the kernel is gone)"; }
    done
    write_rule || true
    refresh_initramfs || true
    exit 0   # never fails the kernel update
    ;;
  --kernel|"")
    k=$(uname -r)
    [[ ${1:-} != --kernel ]] || k=${2:?--kernel needs a version}
    migrate
    rc=0; build "$k" || rc=1
    write_rule
    refresh_initramfs || true
    exit $rc
    ;;
  --unprivileged)
    [[ $EUID != 0 ]] || { echo "omacvm-virtio-gpu: --unprivileged is not for root" >&2; exit 2; }
    fetch_and_make "$2" "$3" "$4"
    ;;
  *)
    echo "usage: omacvm-virtio-gpu-build [--kernel VERSION | --hook | --status | --remove]" >&2
    exit 2
    ;;
esac

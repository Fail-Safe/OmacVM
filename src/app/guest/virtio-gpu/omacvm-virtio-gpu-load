#!/bin/bash
# OmacVM.app: modprobe runs this for virtio_gpu (the install rule in
# /etc/modprobe.d/omacvm-virtio-gpu.conf, from omacvm-virtio-gpu-build), at
# boot from udev, as root. It loads OmacVM's driver only when this start asks
# for it and it is built for the running kernel: SMBIOS omacvm.deepcolor=1
# from the app's HDR switch, omacvm.hdr=1 from an older app's hidden one,
# omacvm.pointerplane=2 from the switch "Pointer on its own layer",
# omacvm.vsynclock=1 from "Frames in step with the Mac", omacvm.damage=1 from
# "Draw only what changed" (the build's Linux 7.4 damage fix: the
# compositor's damage reaches QEMU, which then shows only what changed); else,
# and on any failure, the stock driver. The VM never goes without one.
# Each switch adds its own module option: 10-bit deep_color=1 (the 10-bit
# formats; without it the driver offers what the stock one does), the pointer
# layer cursor_plane=1, but not with omacvm.hwcursor=1 (the Mac pointer needs
# the hotspot that this plane does not get), the refresh vsync_lock=1. The
# damage fix is no option: it is in the build when the kernel needed it
# (its file "damage": ours, kernel, unknown), and in every start of ours.
# omacvm.pointerplane=1 is an app (3.2.3 and older) whose QEMU shows the
# pointer over its main window only: no plane then, Hyprland draws the
# pointer (with the plane, other displays had none, #554).
# /run/omacvm/virtio-gpu says which: "omacvm" (10-bit) or "omacvm 8-bit",
# then " cursor_plane=1" with the plane and " vsync_lock=1", then " without
# NAME" for each asked option this kernel's build does not have (its patch
# did not fit), or "stock WHY".
#   omacvm-virtio-gpu-load [module options]
set -u
umask 022
# Tests only: a made-up file system under this folder, stand-ins on the PATH.
P=${OMACVM_VIRTIO_GPU_TEST_ROOT:-}
[[ -n $P ]] || PATH=/usr/bin:/usr/sbin:/bin:/sbin
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
root=$P/usr/local/lib/omacvm/virtio-gpu
status=$P/run/omacvm/virtio-gpu
kernel=$(uname -r)
ko=$root/$kernel/virtio-gpu.ko

say() {
  { mkdir -p "${status%/*}" && printf '%s\n' "$1" > "$status.tmp" && mv -f "$status.tmp" "$status"; } 2>/dev/null
}

# The strings follow the SMBIOS structure's formatted area (omacvm-smbios
# skips it; a grep over the raw bytes would miss the first string).
# deep: 10-bit asked (deep_color=1); plane: the pointer layer asked
# (cursor_plane=1) by an app that shows it on every display, never with the
# Mac pointer; old: asked by an app that does not (=1); follow: vblanks in step with
# the Mac's refresh asked (vsync_lock=1); fix: the damage fix asked (Draw
# only what changed). Unreadable strings: nothing asked.
deep=0 plane=0 old=0 follow=0 fix=0 why=""
if host=$(python3 -I "$here/../omacvm-smbios" "$P/sys/firmware/dmi/entries" 2>/dev/null); then
  grep -qxE 'OMACVM_(DEEPCOLOR|HDR)=1' <<< "$host" && deep=1
  grep -qx 'OMACVM_POINTERPLANE=2' <<< "$host" && ! grep -qx 'OMACVM_HWCURSOR=1' <<< "$host" && plane=1
  grep -qx 'OMACVM_POINTERPLANE=1' <<< "$host" && old=1
  grep -qx 'OMACVM_VSYNCLOCK=1' <<< "$host" && follow=1
  grep -qx 'OMACVM_DAMAGE=1' <<< "$host" && fix=1
fi
if [[ ! -f $ko ]]; then
  why="not built for $kernel"
elif [[ $(cat "$root/$kernel/stamp" 2>/dev/null) != "$(cat "$root/linux-virtio-gpu-deep-color.patch" "$root/linux-virtio-gpu-cursor-plane.patch" "$root/linux-virtio-gpu-vsync-lock.patch" "$root/linux-virtio-gpu-damage-clips.patch" 2>/dev/null | sha256sum 2>/dev/null | cut -d' ' -f1) $kernel" ]]; then
  why="stamp out of date"
else
  # Only the options this build has: a patch that did not fit this kernel is
  # left out of it (omacvm-virtio-gpu-build), and insmod would refuse an
  # unknown option. (No list at all from modinfo: as before, all asked options.)
  have=$(modinfo -F parm "$ko" 2>/dev/null | cut -d: -f1)
  without=""
  for o in deep plane follow; do
    case $o in deep) n=deep_color ;; plane) n=cursor_plane ;; follow) n=vsync_lock ;; esac
    if [[ -n $have ]] && (( ${!o} )) && ! grep -qx "$n" <<< "$have"; then printf -v "$o" 0; without+=" without $n"; fi
  done
  # The damage fix: ours in the build, or the kernel's own (the stock driver
  # does the same), else left out of the build or not known.
  kfix=0
  if (( fix )); then
    case $(cat "$root/$kernel/damage" 2>/dev/null) in
      ours) ;;
      kernel) fix=0 kfix=1 ;;
      *) fix=0; without+=" without damage_clips" ;;
    esac
  fi
  if (( deep || plane || follow || fix )); then
    for dep in $(modinfo -F depends "$ko" 2>/dev/null | tr ',' ' '); do
      modprobe -q "$dep" 2>/dev/null
    done
    opts=()
    (( plane )) && opts+=(cursor_plane=1)
    (( follow )) && opts+=(vsync_lock=1)
    opts+=("$@")
    (( deep )) && opts+=(deep_color=1)
    if err=$(insmod "$ko" ${opts[@]+"${opts[@]}"} 2>&1); then
      s=omacvm; (( deep )) || s="omacvm 8-bit"; (( plane )) && s+=" cursor_plane=1"; (( follow )) && s+=" vsync_lock=1"
      say "$s$without"
      exit 0
    fi
    why="insmod failed: $(printf '%s\n' "$err" | head -1)"
  elif [[ -n $without ]]; then
    why="built${without} for $kernel"
  elif (( kfix )); then
    why="not needed: the kernel keeps the damage itself"
  elif (( old )); then
    why="the app shows the pointer layer on its main display only (update the app)"
  else
    why="not asked for this start"
  fi
fi
say "stock $why"
exec modprobe --ignore-install virtio_gpu "$@"

From: OmacVM
Subject: [PATCH] drm/virtio: vblank timer in step with the host's refresh

Module option vsync_lock, off by default (the stock timer).

virtio-gpu's vblank is a timer at the mode's rate that starts at whatever
moment the first frame after a pause came: its phase has nothing to do
with the host display's refresh. A compositor draws right after a vblank;
the host (OmacVM.app's QEMU) shows a finished frame at its next refresh.
While frames come steadily (the pointer moving, an animation, a video) a
frame then waits up to a whole refresh in the host for nothing: about 11
ms more for a key at 60 Hz than on an idle screen (work notes
input-latency, Mac mini, 2026-10-25).

With vsync_lock=1 the driver asks the host for its refresh grid
(VIRTIO_GPU_CMD_OMACVM_VSYNC, OmacVM's own command, 0x0f00; answer
0x11f0 with the guest counter value of a vblank the host wants and the
period in ps), when the timer starts and every half second while it runs
(every 100 ms in its first half second). The answer is turned from the
counter (CNTVCT, the host's clock less the VM's offset) into
CLOCK_MONOTONIC. At each vblank the timer takes the host's period and
moves its next expiry toward the nearest grid point, at most an eighth of
a period, never to within a quarter period of now: from any phase it is
on the grid in at most six vblanks, and no frame is more than an eighth
shorter or longer than the others. No answer, a grid older than 2 s, or a
period more than 2 % off the mode's: the timer runs as before. Each ask
(version 1) says whether the timer was on the last grid at its last vblank
(LOCKED) and the mode's frame time, so the host counts the guest's frames
as in step only while they are (not while the rates differ or no grid came).
A host that does not know the command answers with an error once and is not
asked again. The kernel log says once "vsync_lock: in step with the host's
refresh", "the host's refresh (...) is not the mode's" or "the host does not
know it" (omacvm check reads them). The option is readable by every user
(0444).

Applies after linux-virtio-gpu-cursor-plane.patch. Upstream: not for
sending (the command is OmacVM's). Test: src/tests/virtio-gpu-vsync.sh
(this patch's math against a simulated timer); in a VM,
/sys/module/virtio_gpu/parameters/vsync_lock reads Y and QEMU's trace
cocoa_present_follow shows the guest's frames arriving after their
vblank.
--- a/drivers/gpu/drm/virtio/virtgpu_display.c
+++ b/drivers/gpu/drm/virtio/virtgpu_display.c
@@ -35,6 +35,8 @@
 #include <drm/drm_simple_kms_helper.h>
 #include <drm/drm_vblank.h>
 #include <drm/drm_vblank_helper.h>
+#include <linux/moduleparam.h>
+#include <asm/arch_timer.h>
 
 #include "virtgpu_drv.h"
 
@@ -50,6 +52,271 @@
 #define drm_connector_to_virtio_gpu_output(x) \
 	container_of(x, struct virtio_gpu_output, conn)
 
+/*
+ * OmacVM, vsync_lock=1 (off by default: the stock timer). The vblank timer
+ * runs at the mode's rate but at the phase of the moment it started, which
+ * has nothing to do with the host display's refresh. The host shows a frame
+ * at its next refresh, so a frame done just after one waits almost a whole
+ * refresh there, on top of the wait for this timer. With the option the
+ * timer follows a grid the host gives (VIRTIO_GPU_CMD_OMACVM_VSYNC): vblanks
+ * at the times it wants (a little before its refresh, so a frame drawn
+ * right after a vblank is shown at the next refresh) and at its exact
+ * period. Each vblank moves the timer at most an eighth of a period toward
+ * the grid, so no frame is much shorter or longer than the others. Without
+ * an answer, or an old one, or a period that is not the mode's, the timer
+ * runs as before. Each ask says whether the timer was on the last grid
+ * (LOCKED) and the mode's frame time: the host counts the guest's frames as
+ * in step only then. A host that does not know the command (another QEMU)
+ * is asked once.
+ */
+bool virtio_gpu_vsync_lock;
+module_param_named(vsync_lock, virtio_gpu_vsync_lock, bool, 0444);
+MODULE_PARM_DESC(vsync_lock, "Vblanks in step with the host display's refresh (OmacVM)");
+
+#define VSYNC_ASK_FIRST_NS	(100 * NSEC_PER_MSEC)	/* first half second after a start */
+#define VSYNC_ASK_NS		(500 * NSEC_PER_MSEC)
+#define VSYNC_ASK_AGAIN_NS	NSEC_PER_SEC		/* an ask with no answer: again */
+#define VSYNC_OLD_NS		(2 * NSEC_PER_SEC)	/* a grid older than this is not used */
+
+/* vsync math: plain integers, tested on its own (src/tests/virtio-gpu-vsync.sh). */
+/* The grid point nearest to t, both as ns from the anchor (period in ps). */
+static s64 vsync_nearest_ns(s64 since_anchor_ns, u64 period_ps)
+{
+	s64 x = since_anchor_ns * 1000 + (s64)(period_ps / 2);
+	s64 n = div64_s64(x, (s64)period_ps);
+
+	if (x < 0 && n * (s64)period_ps != x)
+		n--;	/* floor, not toward zero */
+	return div64_s64(n * (s64)period_ps, 1000);
+}
+
+/*
+ * How far to move the next vblank, `next` ns after the anchor and `left` ns
+ * from now: toward the nearest grid point, at most an eighth of a period,
+ * and never so early that it would come within a quarter period of now.
+ */
+static s64 vsync_step_ns(s64 next, s64 left, u64 period_ps)
+{
+	s64 period_ns = div64_s64((s64)period_ps + 500, 1000);
+	s64 err = vsync_nearest_ns(next, period_ps) - next;
+	s64 step = clamp_t(s64, err, -period_ns / 8, period_ns / 8);
+
+	if (step < 0 && left + step < period_ns / 4)
+		step = 0;
+	return step;
+}
+
+/* The host's period fits the mode's frame time (within 2 %). */
+static bool vsync_rate_ok(u64 period_ps, s64 framedur_ns)
+{
+	s64 period_ns = div64_s64((s64)period_ps + 500, 1000);
+	s64 d = period_ns - framedur_ns;
+
+	return framedur_ns > 0 && (d < 0 ? -d : d) <= framedur_ns / 50;
+}
+/* end of the vsync math */
+
+/*
+ * Process context: ask the host. The ask says whether the timer is on the
+ * last grid (LOCKED) and the mode's frame time, so the host treats the
+ * guest's frames as in step only when they are.
+ */
+static void virtio_gpu_vsync_ask(struct work_struct *work)
+{
+	struct virtio_gpu_vsync *vs =
+		container_of(work, struct virtio_gpu_vsync, work);
+	struct virtio_gpu_output *output =
+		container_of(vs, struct virtio_gpu_output, vsync);
+	struct virtio_gpu_device *vgdev = output->crtc.dev->dev_private;
+	s64 framedur = drm_crtc_vblank_crtc(&output->crtc)->framedur_ns;
+	bool locked, tell_lock, tell_rate;
+	u64 period_ps;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vs->lock, flags);
+	locked = vs->locked;
+	period_ps = vs->period_ps;
+	tell_lock = locked && !vs->told_lock;
+	tell_rate = vs->rate_off && !vs->told_rate;
+	vs->told_lock |= tell_lock;
+	vs->told_rate |= tell_rate;
+	spin_unlock_irqrestore(&vs->lock, flags);
+	/* Once per load each: omacvm check reads these. */
+	if (tell_lock)
+		drm_info(output->crtc.dev, "vsync_lock: in step with the host's refresh\n");
+	if (tell_rate)
+		drm_info(output->crtc.dev, "vsync_lock: the host's refresh (%llu us) is not the mode's (%lld us), the vblank timer runs on its own\n",
+			 div64_u64(period_ps, 1000000), div64_s64(framedur, 1000));
+
+	virtio_gpu_cmd_omacvm_vsync(vgdev, output->index,
+				    locked ? VIRTIO_GPU_OMACVM_VSYNC_LOCKED : 0,
+				    framedur > 0 && framedur < U32_MAX ? (u32)framedur : 0);
+	virtio_gpu_notify(vgdev);
+}
+
+/* Any context: ask for the grid if due (lock held). */
+static bool vsync_due(struct virtio_gpu_vsync *vs, ktime_t now)
+{
+	s64 every = ktime_to_ns(ktime_sub(now, vs->enabled)) < NSEC_PER_SEC / 2 ?
+		    VSYNC_ASK_FIRST_NS : VSYNC_ASK_NS;
+	s64 since = ktime_to_ns(ktime_sub(now, vs->asked));
+
+	if (vs->unsupported)
+		return false;
+	if (vs->pending && since < VSYNC_ASK_AGAIN_NS)
+		return false;
+	if (since < every)
+		return false;
+	vs->pending = true;
+	vs->asked = now;
+	return true;
+}
+
+/* The ctrl queue's reply (process context). */
+void virtio_gpu_vsync_reply(struct virtio_gpu_output *output,
+			    const struct virtio_gpu_resp_omacvm_vsync *resp)
+{
+	struct virtio_gpu_vsync *vs = &output->vsync;
+	u32 type = le32_to_cpu(resp->hdr.type);
+	u64 period_ps = le64_to_cpu(resp->period_ps);
+	u64 vblank = le64_to_cpu(resp->vblank);
+	bool ok = type == VIRTIO_GPU_RESP_OK_OMACVM_VSYNC &&
+		  (le32_to_cpu(resp->flags) & VIRTIO_GPU_OMACVM_VSYNC_VALID) &&
+		  period_ps >= 1000000000ULL &&	/* 1 ms .. 100 ms */
+		  period_ps <= 100000000000ULL;
+	unsigned long flags;
+	ktime_t now, anchor = 0;
+	u32 freq;
+
+	if (ok) {
+		u64 cnt;
+		s64 ticks;
+
+		/* The counter and the clock read together. */
+		local_irq_save(flags);
+		cnt = __arch_counter_get_cntvct();
+		now = ktime_get();
+		local_irq_restore(flags);
+		freq = arch_timer_get_cntfrq();
+		ticks = (s64)(vblank - cnt);
+		/* The host sends a vblank within a second or so of now. */
+		if (!freq || ticks > (s64)freq * 4 || ticks < -(s64)freq * 4)
+			ok = false;
+		else
+			anchor = ktime_add_ns(now, div_s64(ticks * NSEC_PER_MSEC, freq / 1000 ? freq / 1000 : 1));
+	} else {
+		now = ktime_get();
+	}
+
+	spin_lock_irqsave(&vs->lock, flags);
+	vs->pending = false;
+	if (type >= VIRTIO_GPU_RESP_ERR_UNSPEC) {
+		if (!vs->unsupported)
+			drm_info(output->crtc.dev, "vsync_lock: the host does not know it, the vblank timer runs on its own\n");
+		vs->unsupported = true;
+		vs->valid = false;
+	} else if (ok) {
+		vs->anchor = anchor;
+		vs->period_ps = period_ps;
+		vs->got = now;
+		vs->valid = true;
+	} else {
+		vs->valid = false;
+	}
+	spin_unlock_irqrestore(&vs->lock, flags);
+}
+
+/*
+ * The timer's interrupt, after this vblank was handled: the timer is
+ * already forwarded to the next one. Move that toward the host's grid.
+ */
+static void virtio_gpu_vsync_follow(struct virtio_gpu_output *output)
+{
+	struct virtio_gpu_vsync *vs = &output->vsync;
+	struct drm_vblank_crtc *vblank = drm_crtc_vblank_crtc(&output->crtc);
+	struct drm_vblank_crtc_timer *vtimer = &vblank->vblank_timer;
+	ktime_t now = ktime_get(), next, anchor;
+	s64 period_ns, step, framedur = vblank->framedur_ns;
+	u64 period_ps;
+	bool valid, ask;
+
+	spin_lock(&vs->lock);
+	valid = vs->valid &&
+		ktime_to_ns(ktime_sub(now, vs->got)) < VSYNC_OLD_NS;
+	anchor = vs->anchor;
+	period_ps = vs->period_ps;
+	/* The mode's rate and the host's must agree (within 2 %), else no follow. */
+	vs->rate_off = valid && framedur > 0 && !vsync_rate_ok(period_ps, framedur);
+	valid = valid && vsync_rate_ok(period_ps, framedur);
+	vs->locked = valid;
+	ask = vsync_due(vs, now);
+	spin_unlock(&vs->lock);
+	if (ask)
+		schedule_work(&vs->work);
+	if (!valid)
+		return;
+	period_ns = div64_u64(period_ps + 500, 1000);
+
+	/*
+	 * The vblank timestamps (and drm_crtc_vblank_get_vblank_timeout) count
+	 * from the interval, so for a vblank after a step they are off by up to
+	 * an eighth of a period; on the grid the step is zero.
+	 */
+	spin_lock(&vtimer->interval_lock);
+	if (vtimer->interval)	/* zero: the timer is being stopped */
+		vtimer->interval = ns_to_ktime(period_ns);
+	spin_unlock(&vtimer->interval_lock);
+
+	next = hrtimer_get_expires(&vtimer->timer);
+	step = vsync_step_ns(ktime_to_ns(ktime_sub(next, anchor)),
+			     ktime_to_ns(ktime_sub(next, now)), period_ps);
+	if (step)
+		hrtimer_set_expires(&vtimer->timer, ktime_add_ns(next, step));
+}
+
+static bool virtio_gpu_crtc_vblank_timeout(struct drm_crtc *crtc)
+{
+	bool ret = drm_crtc_handle_vblank(crtc);
+
+	if (ret && virtio_gpu_vsync_lock)
+		virtio_gpu_vsync_follow(drm_crtc_to_virtio_gpu_output(crtc));
+	return ret;
+}
+
+static int virtio_gpu_crtc_enable_vblank(struct drm_crtc *crtc)
+{
+	struct virtio_gpu_output *output = drm_crtc_to_virtio_gpu_output(crtc);
+	struct virtio_gpu_vsync *vs = &output->vsync;
+	int ret = drm_crtc_vblank_helper_enable_vblank_timer(crtc);
+	unsigned long flags;
+	bool ask;
+
+	if (ret || !virtio_gpu_vsync_lock)
+		return ret;
+	/*
+	 * Ask at once; the timer comes into step over the next vblanks (the
+	 * host's display link may only start with these frames).
+	 */
+	spin_lock_irqsave(&vs->lock, flags);
+	vs->enabled = ktime_get();
+	vs->asked = 0;
+	vs->locked = false;	/* the timer starts at a phase of its own */
+	ask = vsync_due(vs, vs->enabled);
+	spin_unlock_irqrestore(&vs->lock, flags);
+	if (ask)
+		schedule_work(&vs->work);
+	return 0;
+}
+
+void virtio_gpu_vsync_fini(struct virtio_gpu_device *vgdev)
+{
+	int i;
+
+	for (i = 0; i < vgdev->num_scanouts; i++)
+		if (vgdev->outputs[i].vsync.work.func)	/* the output was set up */
+			cancel_work_sync(&vgdev->outputs[i].vsync.work);
+}
+
 static const struct drm_crtc_funcs virtio_gpu_crtc_funcs = {
 	.set_config             = drm_atomic_helper_set_config,
 	.destroy                = drm_crtc_cleanup,
@@ -58,7 +325,10 @@
 	.reset                  = drm_atomic_helper_crtc_reset,
 	.atomic_duplicate_state = drm_atomic_helper_crtc_duplicate_state,
 	.atomic_destroy_state   = drm_atomic_helper_crtc_destroy_state,
-	DRM_CRTC_VBLANK_TIMER_FUNCS,
+	/* DRM_CRTC_VBLANK_TIMER_FUNCS, with OmacVM's start of the timer (vsync_lock) */
+	.enable_vblank          = virtio_gpu_crtc_enable_vblank,
+	.disable_vblank         = drm_crtc_vblank_helper_disable_vblank_timer,
+	.get_vblank_timestamp   = drm_crtc_vblank_helper_get_vblank_timestamp_from_timer,
 };
 
 static const struct drm_framebuffer_funcs virtio_gpu_fb_funcs = {
@@ -163,6 +433,7 @@
 	.atomic_flush  = virtio_gpu_crtc_atomic_flush,
 	.atomic_enable = virtio_gpu_crtc_atomic_enable,
 	.atomic_disable = virtio_gpu_crtc_atomic_disable,
+	.handle_vblank_timeout = virtio_gpu_crtc_vblank_timeout,
 };
 
 static void virtio_gpu_enc_mode_set(struct drm_encoder *encoder,

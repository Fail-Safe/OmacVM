 	int ret;
 
 	output->index = index;
+	spin_lock_init(&output->vsync.lock);
+	INIT_WORK(&output->vsync.work, virtio_gpu_vsync_ask);
 	if (index == 0) {
 		output->info.enabled = cpu_to_le32(true);
 		output->info.r.width = cpu_to_le32(XRES_DEF);
--- a/drivers/gpu/drm/virtio/virtgpu_drv.h
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.h
@@ -197,6 +197,52 @@
 
 	/* guest-bound transfer whose shmem backing needs a CPU sync */
 	bool sync_for_cpu;
+};
+
+/*
+ * OmacVM (vsync_lock=1): the host's display refresh, for the vblank timer.
+ * The host answers VIRTIO_GPU_CMD_OMACVM_VSYNC with the guest counter
+ * value of a vblank it wants and the period; the timer follows that grid.
+ * The ask (version 1) says whether the timer is on the last grid and the
+ * mode's frame time: the host counts the frames as in step only then.
+ * lock guards the grid (taken in the timer's interrupt and in the reply).
+ */
+#define VIRTIO_GPU_CMD_OMACVM_VSYNC 0x0f00
+#define VIRTIO_GPU_RESP_OK_OMACVM_VSYNC 0x11f0
+#define VIRTIO_GPU_OMACVM_VSYNC_VALID (1 << 0)
+#define VIRTIO_GPU_OMACVM_VSYNC_LOCKED (1 << 0)
+#define VIRTIO_GPU_OMACVM_VSYNC_VERSION 1
+
+struct virtio_gpu_omacvm_vsync {
+	struct virtio_gpu_ctrl_hdr hdr;
+	__le32 scanout_id;
+	__le32 flags;		/* VIRTIO_GPU_OMACVM_VSYNC_LOCKED: on the last grid */
+	__le32 version;		/* VIRTIO_GPU_OMACVM_VSYNC_VERSION */
+	__le32 mode_period_ns;	/* the mode's frame time; 0: none */
+};
+
+struct virtio_gpu_resp_omacvm_vsync {
+	struct virtio_gpu_ctrl_hdr hdr;
+	__le64 vblank;		/* guest virtual counter (CNTVCT) of a vblank */
+	__le64 period_ps;	/* the host display's refresh period */
+	__le32 flags;		/* VIRTIO_GPU_OMACVM_VSYNC_VALID: a grid now */
+	__le32 padding;
+};
+
+struct virtio_gpu_vsync {
+	spinlock_t lock;
+	struct work_struct work;
+	ktime_t anchor;		/* a wanted vblank, CLOCK_MONOTONIC */
+	u64 period_ps;
+	ktime_t got;		/* when the last grid came */
+	ktime_t asked;		/* when the last ask went out */
+	ktime_t enabled;	/* when the timer started */
+	bool valid;
+	bool pending;		/* an ask is out */
+	bool unsupported;	/* the host does not know the command */
+	bool locked;		/* the timer followed the grid at its last vblank */
+	bool rate_off;		/* the host's period is not the mode's */
+	bool told_lock, told_rate;	/* said once in the kernel log */
 };
 
 struct virtio_gpu_output {
@@ -210,6 +256,7 @@
 	int cur_x;
 	int cur_y;
 	bool needs_modeset;
+	struct virtio_gpu_vsync vsync;
 };
 #define drm_crtc_to_virtio_gpu_output(x) \
 	container_of(x, struct virtio_gpu_output, crtc)
@@ -405,6 +452,9 @@
 			      int idx, int version,
 			      struct virtio_gpu_drv_cap_cache **cache_p);
 int virtio_gpu_cmd_get_edids(struct virtio_gpu_device *vgdev);
+void virtio_gpu_cmd_omacvm_vsync(struct virtio_gpu_device *vgdev,
+				 uint32_t scanout_id, uint32_t flags,
+				 uint32_t mode_period_ns);
 void virtio_gpu_cmd_context_create(struct virtio_gpu_device *vgdev, uint32_t id,
 				   uint32_t context_init, uint32_t nlen,
 				   const char *name);
@@ -477,6 +527,10 @@
 /* virtgpu_display.c */
 int virtio_gpu_modeset_init(struct virtio_gpu_device *vgdev);
 void virtio_gpu_modeset_fini(struct virtio_gpu_device *vgdev);
+void virtio_gpu_vsync_fini(struct virtio_gpu_device *vgdev);
+void virtio_gpu_vsync_reply(struct virtio_gpu_output *output,
+			    const struct virtio_gpu_resp_omacvm_vsync *resp);
+extern bool virtio_gpu_vsync_lock;
 
 extern bool virtio_gpu_cursor_plane;
 
--- a/drivers/gpu/drm/virtio/virtgpu_kms.c
+++ b/drivers/gpu/drm/virtio/virtgpu_kms.c
@@ -296,2 +296,3 @@
 	flush_work(&vgdev->obj_free_work);
+	virtio_gpu_vsync_fini(vgdev);
 	flush_work(&vgdev->ctrlq.dequeue_work);
--- a/drivers/gpu/drm/virtio/virtgpu_vq.c
+++ b/drivers/gpu/drm/virtio/virtgpu_vq.c
@@ -953,8 +953,53 @@
 
 	drm_edid_free(old_edid);
 	wake_up(&vgdev->resp_wq);
+}
+
+static void virtio_gpu_cmd_omacvm_vsync_cb(struct virtio_gpu_device *vgdev,
+					   struct virtio_gpu_vbuffer *vbuf)
+{
+	struct virtio_gpu_omacvm_vsync *cmd =
+		(struct virtio_gpu_omacvm_vsync *)vbuf->buf;
+	struct virtio_gpu_resp_omacvm_vsync *resp =
+		(struct virtio_gpu_resp_omacvm_vsync *)vbuf->resp_buf;
+	uint32_t scanout = le32_to_cpu(cmd->scanout_id);
+
+	if (scanout >= vgdev->num_scanouts)
+		return;
+	virtio_gpu_vsync_reply(vgdev->outputs + scanout, resp);
 }
 
+/* OmacVM: ask the host for its display's refresh (vsync_lock=1). */
+void virtio_gpu_cmd_omacvm_vsync(struct virtio_gpu_device *vgdev,
+				 uint32_t scanout_id, uint32_t flags,
+				 uint32_t mode_period_ns)
+{
+	struct virtio_gpu_omacvm_vsync *cmd_p;
+	struct virtio_gpu_vbuffer *vbuf;
+	void *resp_buf;
+
+	resp_buf = kzalloc(sizeof(struct virtio_gpu_resp_omacvm_vsync), GFP_KERNEL);
+	if (!resp_buf) {
+		struct virtio_gpu_resp_omacvm_vsync none = {};
+
+		virtio_gpu_vsync_reply(vgdev->outputs + scanout_id, &none);
+		return;
+	}
+
+	cmd_p = virtio_gpu_alloc_cmd_resp
+		(vgdev, &virtio_gpu_cmd_omacvm_vsync_cb, &vbuf,
+		 sizeof(*cmd_p), sizeof(struct virtio_gpu_resp_omacvm_vsync),
+		 resp_buf);
+	memset(cmd_p, 0, sizeof(*cmd_p));
+
+	cmd_p->hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_OMACVM_VSYNC);
+	cmd_p->scanout_id = cpu_to_le32(scanout_id);
+	cmd_p->flags = cpu_to_le32(flags);
+	cmd_p->version = cpu_to_le32(VIRTIO_GPU_OMACVM_VSYNC_VERSION);
+	cmd_p->mode_period_ns = cpu_to_le32(mode_period_ns);
+	virtio_gpu_queue_ctrl_buffer(vgdev, vbuf);
+}
+
 int virtio_gpu_cmd_get_display_info(struct virtio_gpu_device *vgdev)
 {
 	struct virtio_gpu_ctrl_hdr *cmd_p;

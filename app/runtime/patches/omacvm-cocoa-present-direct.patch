 static void cocoa_gl_present_request(void);
+
+/*
+ * OmacVM, direct to display (OMACVM_GL_DIRECT=1: the app's experimental
+ * switch "Show directly on the display"): the view's layer is a
+ * CAMetalLayer and QEMU's GL draws each frame straight into one of its
+ * drawables (their IOSurfaces bound as GL textures, in present_surf/_tex)
+ * instead of into surfaces of its own that a plain CALayer shows. macOS 27
+ * then shows a full-screen window on the display itself, without
+ * WindowServer's composite, while no other window covers any part of it; a
+ * CALayer showing IOSurfaces is always composited (measured on an M2: 0 vs
+ * 55-110 WindowServer GPU ms/s at 60 frames/s). Same pixels and colour
+ * tags, same frames and pacing: the vsync queue holds the drawables as it
+ * held the surfaces, and a frame is presented where a surface was set.
+ *
+ * Threads: drawables come from direct_queue (nextDrawable can block while
+ * all three are on screen or queued); QEMU's thread takes the spare one
+ * without waiting, and treats "none yet" as all surfaces busy (the frame
+ * waits a refresh, as before). The commit thread presents. direct_lock
+ * guards the spare and the drawables of queued frames.
+ *
+ * Needs the vsync present and a Metal device; otherwise, and with GPU safe
+ * mode (OMACVM_GL_PRESENT=layer), the plain layer as before. A drawable GL
+ * cannot draw into turns it off for the run (plain layer, one warning).
+ * qemu.log says when the display shows the window itself and when it is
+ * composited (Core Animation's own status of the layer), and once a
+ * minute how many frames went direct.
+ */
+#define DIRECT_PENDING PRESENT_SURFACES
+static int present_direct = -1;         /* 1: CAMetalLayer drawables */
+static CAMetalLayer *direct_layer;
+static dispatch_queue_t direct_queue;
+static os_unfair_lock direct_lock = OS_UNFAIR_LOCK_INIT;
+static id<CAMetalDrawable> direct_spare;           /* direct_lock */
+static bool direct_fetching;                       /* direct_lock */
+static struct {
+    IOSurfaceRef surf;
+    id<CAMetalDrawable> drawable;
+} direct_pending[DIRECT_PENDING];                  /* direct_lock */
+static int direct_shown_state = -1;     /* commit thread: 1 direct, 0 composited */
+static double direct_state_logged;      /* commit thread */
+static unsigned direct_frames, direct_frames_direct; /* commit thread */
+static double direct_minute;            /* commit thread */
+
+/* Main thread, once, from the view's init: the layer, or nil for the plain one. */
+static CALayer *omacvm_direct_layer_new(void)
+{
+    const char *e = getenv("OMACVM_GL_DIRECT");
+    const char *v = getenv("OMACVM_GL_VSYNC");
+
+    present_direct = 0;
+    if (!(e && !strcmp(e, "1"))) {
+        return nil;
+    }
+    if (v && !strcmp(v, "0")) {
+        info_report("cocoa: direct to display: off (needs the vsync present)");
+        return nil;
+    }
+    /* Metal is not linked into QEMU: the device through dlsym. */
+    void *mtl = dlopen("/System/Library/Frameworks/Metal.framework/Metal", RTLD_LAZY);
+    id<MTLDevice> (*create)(void) =
+        mtl ? (id<MTLDevice> (*)(void))dlsym(mtl, "MTLCreateSystemDefaultDevice") : NULL;
+    id<MTLDevice> dev = create ? create() : nil;
+    if (!dev) {
+        warn_report("cocoa: direct to display: off (no Metal device)");
+        return nil;
+    }
+    CAMetalLayer *layer = [[CAMetalLayer alloc] init];
+    [layer setDevice:dev];
+    [dev release];
+    [layer setPixelFormat:MTLPixelFormatBGRA8Unorm];
+    /* GL draws into the drawables' IOSurfaces. */
+    [layer setFramebufferOnly:NO];
+    [layer setMaximumDrawableCount:3];
+    [layer setDisplaySyncEnabled:YES];
+    [layer setAllowsNextDrawableTimeout:YES];
+    direct_layer = [layer retain];
+    direct_queue = dispatch_queue_create("org.omacvm.present.drawable",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                QOS_CLASS_USER_INTERACTIVE, 0));
+    present_direct = 1;
+    info_report("cocoa: direct to display: on (frames drawn into a CAMetalLayer's "
+                "drawables; the display shows a full-screen window itself while "
+                "nothing covers it)");
+    return layer;
+}
+
+static bool omacvm_direct_on(void)
+{
+    return qatomic_read(&present_direct) == 1;
+}
+
+/* Any thread: have direct_queue get the next drawable, if none is waiting. */
+static void omacvm_direct_fetch(void)
+{
+    os_unfair_lock_lock(&direct_lock);
+    bool go = omacvm_direct_on() && !direct_spare && !direct_fetching;
+    direct_fetching |= go;
+    os_unfair_lock_unlock(&direct_lock);
+    if (!go) {
+        return;
+    }
+    dispatch_async(direct_queue, ^{
+        @autoreleasepool {
+            id<CAMetalDrawable> d = [direct_layer nextDrawable];
+            os_unfair_lock_lock(&direct_lock);
+            direct_fetching = false;
+            if (d && omacvm_direct_on()) {
+                direct_spare = [d retain];
+            }
+            os_unfair_lock_unlock(&direct_lock);
+            /* A frame may be waiting for it (all busy: gl_dirty). */
+            if (d && present_bh) {
+                qemu_bh_schedule(present_bh);
+            }
+        }
+    });
+}
+
+/* QEMU thread: the spare drawable (retained), or nil; the next is fetched. */
+static id<CAMetalDrawable> omacvm_direct_take(void)
+{
+    os_unfair_lock_lock(&direct_lock);
+    id<CAMetalDrawable> d = direct_spare;
+    direct_spare = nil;
+    os_unfair_lock_unlock(&direct_lock);
+    omacvm_direct_fetch();
+    return d;
+}
+
+/* QEMU thread: a spare of the old size or kind is no use after a change. */
+static void omacvm_direct_drop_spare(void)
+{
+    os_unfair_lock_lock(&direct_lock);
+    id<CAMetalDrawable> d = direct_spare;
+    direct_spare = nil;
+    os_unfair_lock_unlock(&direct_lock);
+    [d release];
+}
+
+/* QEMU thread: surf's frame was drawn into d; held until the frame is put. */
+static void omacvm_direct_hold(IOSurfaceRef surf, id<CAMetalDrawable> d)
+{
+    os_unfair_lock_lock(&direct_lock);
+    for (int i = 0; i < DIRECT_PENDING; i++) {
+        if (!direct_pending[i].surf) {
+            direct_pending[i].surf = surf;
+            direct_pending[i].drawable = d;
+            d = nil;
+            break;
+        }
+    }
+    os_unfair_lock_unlock(&direct_lock);
+    /* No room cannot happen (at most three drawables); never leak one. */
+    [d release];
+}
+
+/* Commit thread: the display shows the window itself, or WindowServer composites it. */
+static void omacvm_direct_status(void)
+{
+    static int has = -1;
+    SEL sel = NSSelectorFromString(@"displayCompositingInternalStatus");
+    double now = CACurrentMediaTime();
+
+    if (has < 0) {
+        has = [direct_layer respondsToSelector:sel];
+    }
+    if (!has) {
+        return;
+    }
+    /* Core Animation's own status of the layer: 0 while shown directly. */
+    unsigned long long st =
+        ((unsigned long long (*)(id, SEL))objc_msgSend)(direct_layer, sel);
+    int state = st == 0;
+    direct_frames++;
+    direct_frames_direct += state;
+    if (state != direct_shown_state && now - direct_state_logged >= 10) {
+        direct_shown_state = state;
+        direct_state_logged = now;
+        if (state) {
+            info_report("cocoa: direct to display: the display shows the window itself");
+        } else {
+            info_report("cocoa: direct to display: composited by WindowServer "
+                        "(status 0x%llx: not full screen, or another window covers "
+                        "part of it)", st);
+        }
+    }
+    if (!direct_minute) {
+        direct_minute = now;
+    } else if (now - direct_minute >= 60) {
+        info_report("cocoa: direct to display, last minute: %u of %u frames "
+                    "shown directly", direct_frames_direct, direct_frames);
+        direct_frames = direct_frames_direct = 0;
+        direct_minute = now;
+    }
+}
+
+/* Commit thread, in place of setting the layer's contents: present surf's drawable. */
+static bool omacvm_direct_show(IOSurfaceRef surf)
+{
+    id<CAMetalDrawable> d = nil;
+
+    os_unfair_lock_lock(&direct_lock);
+    for (int i = 0; i < DIRECT_PENDING; i++) {
+        if (direct_pending[i].surf == surf) {
+            d = [direct_pending[i].drawable retain];
+            break;
+        }
+    }
+    os_unfair_lock_unlock(&direct_lock);
+    if (!d) {
+        return false;
+    }
+    [d present];
+    [d release];
+    omacvm_direct_status();
+    return true;
+}
+
+/* Any thread: surf's frame is done with (shown or dropped): let its drawable go. */
+static void omacvm_direct_put(IOSurfaceRef surf)
+{
+    id<CAMetalDrawable> d = nil;
+
+    os_unfair_lock_lock(&direct_lock);
+    for (int i = 0; i < DIRECT_PENDING; i++) {
+        if (direct_pending[i].surf == surf) {
+            d = direct_pending[i].drawable;
+            direct_pending[i].surf = NULL;
+            direct_pending[i].drawable = nil;
+            break;
+        }
+    }
+    os_unfair_lock_unlock(&direct_lock);
+    [d release];
+}
+
+/*
+ * QEMU thread: GL could not draw into a drawable. The plain layer from now
+ * on: frames still queued show from their surfaces as a layer's contents.
+ */
+static void omacvm_direct_fallback(const char *why)
+{
+    warn_report("cocoa: direct to display: off for this run (%s); the plain "
+                "layer from now on", why);
+    qatomic_set(&present_direct, 0);
+    omacvm_direct_drop_spare();
+    dispatch_async(dispatch_get_main_queue(), ^{
+        CALayer *old = [cocoaView layer];
+        CALayer *layer = [[CALayer alloc] init];
+        [layer setOpaque:YES];
+        [layer setBackgroundColor:CGColorGetConstantColor(kCGColorBlack)];
+        [layer setContentsGravity:[old contentsGravity]];
+        [layer setContentsScale:[old contentsScale]];
+        for (CALayer *sub in [[[old sublayers] copy] autorelease]) {
+            [sub removeFromSuperlayer];
+            [layer addSublayer:sub];
+        }
+        [cocoaView setLayer:layer];
+        [layer release];
+    });
+}
 

@@ -7735,6 +7744,405 @@
 static void cocoa_gl_present_request(void);
 
 /*
+ * OmacVM, direct to display (OMACVM_GL_DIRECT=1: the app's experimental
+ * switch "Show directly on the display"): the view's layer is a
+ * CAMetalLayer. QEMU draws each frame into its own surfaces as before
+ * (lossless-compressed 8-bit, half float, partial draws), and the commit
+ * thread copies the frame's surface with Metal into one of the layer's
+ * drawables (lossless-compressed where the surfaces are) instead of setting
+ * it as a plain CALayer's contents. macOS 27 then shows a full-screen
+ * window on the display itself, without WindowServer's composite, while no
+ * other window covers any part of it; a CALayer showing IOSurfaces is
+ * always composited (measured on an M2: 0 vs 55-110 WindowServer GPU ms/s
+ * at 60 frames/s). Same pixels (a copy), colour tags and EDR settings,
+ * same frames and pacing: the vsync queue holds a frame's drawable with
+ * its surface.
+ *
+ * Threads: drawables come from direct_queue (nextDrawable can block while
+ * all three are on screen or queued); QEMU's thread takes the spare one
+ * without waiting and treats "none yet" as all surfaces busy (the frame
+ * waits a refresh, as before). The layer's size and kind change on
+ * direct_queue too, never during a nextDrawable. The commit thread copies
+ * and presents; the surface stays in use until the GPU has copied it.
+ * direct_lock guards the spare and the drawables of queued frames.
+ *
+ * Needs the vsync present and a Metal device; otherwise, and with GPU safe
+ * mode (OMACVM_GL_PRESENT=layer), the plain layer as before. A surface
+ * Metal cannot read turns it off for the run (plain layer, one warning).
+ * qemu.log says when the display shows the window itself and when it is
+ * composited (Core Animation's own status of the layer), and once a minute
+ * how many frames went direct.
+ */
+#define DIRECT_PENDING PRESENT_SURFACES
+#define DIRECT_TEXTURES (2 * PRESENT_SURFACES)
+static int present_direct = -1;         /* 1: CAMetalLayer, frames copied */
+static CAMetalLayer *direct_layer;
+static id<MTLDevice> direct_dev;
+static id<MTLCommandQueue> direct_cq;
+static dispatch_queue_t direct_queue;
+static os_unfair_lock direct_lock = OS_UNFAIR_LOCK_INIT;
+static id<CAMetalDrawable> direct_spare;           /* direct_lock */
+static bool direct_fetching;                       /* direct_lock */
+static struct {
+    IOSurfaceRef surf;
+    id<CAMetalDrawable> drawable;
+} direct_pending[DIRECT_PENDING];                  /* direct_lock */
+static unsigned direct_gen;             /* atomic: new surfaces were made */
+static struct {
+    IOSurfaceRef surf;
+    id<MTLTexture> tex;
+} direct_tex[DIRECT_TEXTURES];          /* commit thread */
+static unsigned direct_tex_gen, direct_tex_next; /* commit thread */
+static int direct_shown_state = -1;     /* commit thread: 1 direct, 0 composited */
+static double direct_state_logged;      /* commit thread */
+static unsigned direct_frames, direct_frames_direct; /* commit thread */
+static double direct_minute;            /* commit thread */
+
+/* Main thread, once, from the view's init: the layer, or nil for the plain one. */
+static CALayer *omacvm_direct_layer_new(void)
+{
+    const char *e = getenv("OMACVM_GL_DIRECT");
+    const char *v = getenv("OMACVM_GL_VSYNC");
+
+    present_direct = 0;
+    if (!(e && !strcmp(e, "1"))) {
+        return nil;
+    }
+    if (v && !strcmp(v, "0")) {
+        info_report("cocoa: direct to display: off (needs the vsync present)");
+        return nil;
+    }
+    /* Metal is not linked into QEMU: the device through dlsym. */
+    void *mtl = dlopen("/System/Library/Frameworks/Metal.framework/Metal", RTLD_LAZY);
+    id<MTLDevice> (*create)(void) =
+        mtl ? (id<MTLDevice> (*)(void))dlsym(mtl, "MTLCreateSystemDefaultDevice") : NULL;
+    id<MTLDevice> dev = create ? create() : nil;
+    id<MTLCommandQueue> cq = [dev newCommandQueue];
+    if (!dev || !cq) {
+        warn_report("cocoa: direct to display: off (no Metal device)");
+        [dev release];
+        return nil;
+    }
+    CAMetalLayer *layer = [[CAMetalLayer alloc] init];
+    [layer setDevice:dev];
+    [layer setPixelFormat:MTLPixelFormatBGRA8Unorm];
+    /* The frames are copied in with a Metal blit. */
+    [layer setFramebufferOnly:NO];
+    [layer setMaximumDrawableCount:3];
+    [layer setDisplaySyncEnabled:YES];
+    [layer setAllowsNextDrawableTimeout:YES];
+    direct_layer = [layer retain];
+    direct_dev = dev;
+    direct_cq = cq;
+    direct_queue = dispatch_queue_create("org.omacvm.present.drawable",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                QOS_CLASS_USER_INTERACTIVE, 0));
+    present_direct = 1;
+    info_report("cocoa: direct to display: on (frames copied into a CAMetalLayer's "
+                "drawables; the display shows a full-screen window itself while "
+                "nothing covers it)");
+    return layer;
+}
+
+static bool omacvm_direct_on(void)
+{
+    return qatomic_read(&present_direct) == 1;
+}
+
+/* Any thread: have direct_queue get the next drawable, if none is waiting. */
+static void omacvm_direct_fetch(void)
+{
+    os_unfair_lock_lock(&direct_lock);
+    bool go = omacvm_direct_on() && !direct_spare && !direct_fetching;
+    direct_fetching |= go;
+    os_unfair_lock_unlock(&direct_lock);
+    if (!go) {
+        return;
+    }
+    dispatch_async(direct_queue, ^{
+        @autoreleasepool {
+            id<CAMetalDrawable> d = [direct_layer nextDrawable];
+            os_unfair_lock_lock(&direct_lock);
+            direct_fetching = false;
+            if (d && omacvm_direct_on()) {
+                direct_spare = [d retain];
+            }
+            os_unfair_lock_unlock(&direct_lock);
+            /* A frame may be waiting for it (all busy: gl_dirty). */
+            if (d && present_bh) {
+                qemu_bh_schedule(present_bh);
+            }
+        }
+    });
+}
+
+/* QEMU thread: the spare drawable (retained), or nil; the next is fetched. */
+static id<CAMetalDrawable> omacvm_direct_take(void)
+{
+    os_unfair_lock_lock(&direct_lock);
+    id<CAMetalDrawable> d = direct_spare;
+    direct_spare = nil;
+    os_unfair_lock_unlock(&direct_lock);
+    omacvm_direct_fetch();
+    return d;
+}
+
+/* QEMU thread: a spare of the old size or kind is no use after a change. */
+static void omacvm_direct_drop_spare(void)
+{
+    os_unfair_lock_lock(&direct_lock);
+    id<CAMetalDrawable> d = direct_spare;
+    direct_spare = nil;
+    os_unfair_lock_unlock(&direct_lock);
+    [d release];
+}
+
+static CGColorSpaceRef cocoa_gl_present_colorspace(bool deep, bool linear);
+
+/*
+ * QEMU thread, after new surfaces: the drawables follow their size, kind
+ * and colours (lossless-compressed where the 8-bit surfaces are; Core
+ * Animation's private switch, macOS 27). On direct_queue, never while a
+ * nextDrawable runs there; drawables made before are dropped when taken.
+ */
+static void omacvm_direct_alloc(uint32_t w, uint32_t h, bool deep, bool linear,
+                                bool compressed)
+{
+    bool half = deep || linear;
+    CGColorSpaceRef cs = cocoa_gl_present_colorspace(deep, linear);
+    MTLPixelFormat pf = half ? MTLPixelFormatRGBA16Float : MTLPixelFormatBGRA8Unorm;
+    CGSize size = CGSizeMake(w, h);
+
+    qatomic_inc(&direct_gen);
+    dispatch_async(direct_queue, ^{
+        SEL sel = NSSelectorFromString(@"setWantsIOSurfaceCompression:");
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        [direct_layer setPixelFormat:pf];
+        [direct_layer setDrawableSize:size];
+        [direct_layer setColorspace:cs];
+        if ([direct_layer respondsToSelector:sel]) {
+            ((void (*)(id, SEL, BOOL))objc_msgSend)(direct_layer, sel, compressed);
+        }
+        [CATransaction commit];
+        CGColorSpaceRelease(cs);
+    });
+    omacvm_direct_drop_spare();
+    omacvm_direct_fetch();
+}
+
+/* QEMU thread: is d made for the surfaces now (size and kind)? */
+static bool omacvm_direct_fits(id<CAMetalDrawable> d, uint32_t w, uint32_t h,
+                               bool half)
+{
+    id<MTLTexture> t = [d texture];
+    return t && [t width] == w && [t height] == h &&
+           [t pixelFormat] == (half ? MTLPixelFormatRGBA16Float :
+                                      MTLPixelFormatBGRA8Unorm);
+}
+
+/* QEMU thread: surf's frame goes into d; held until the frame is put. */
+static void omacvm_direct_hold(IOSurfaceRef surf, id<CAMetalDrawable> d)
+{
+    os_unfair_lock_lock(&direct_lock);
+    for (int i = 0; i < DIRECT_PENDING; i++) {
+        if (!direct_pending[i].surf) {
+            direct_pending[i].surf = surf;
+            direct_pending[i].drawable = d;
+            d = nil;
+            break;
+        }
+    }
+    os_unfair_lock_unlock(&direct_lock);
+    /* No room cannot happen (one per queued surface); never leak one. */
+    [d release];
+}
+
+/* Commit thread: the display shows the window itself, or WindowServer composites it. */
+static void omacvm_direct_status(void)
+{
+    static int has = -1;
+    SEL sel = NSSelectorFromString(@"displayCompositingInternalStatus");
+    double now = CACurrentMediaTime();
+
+    if (has < 0) {
+        has = [direct_layer respondsToSelector:sel];
+    }
+    if (!has) {
+        return;
+    }
+    /* Core Animation's own status of the layer: 0 while shown directly. */
+    unsigned long long st =
+        ((unsigned long long (*)(id, SEL))objc_msgSend)(direct_layer, sel);
+    int state = st == 0;
+    direct_frames++;
+    direct_frames_direct += state;
+    if (state != direct_shown_state && now - direct_state_logged >= 10) {
+        direct_shown_state = state;
+        direct_state_logged = now;
+        if (state) {
+            info_report("cocoa: direct to display: the display shows the window itself");
+        } else {
+            info_report("cocoa: direct to display: composited by WindowServer "
+                        "(status 0x%llx: not full screen, or another window covers "
+                        "part of it)", st);
+        }
+    }
+    if (!direct_minute) {
+        direct_minute = now;
+    } else if (now - direct_minute >= 60) {
+        info_report("cocoa: direct to display, last minute: %u of %u frames "
+                    "shown directly", direct_frames_direct, direct_frames);
+        direct_frames = direct_frames_direct = 0;
+        direct_minute = now;
+    }
+}
+
+/*
+ * Commit thread: a Metal texture on surf, made once per surface. New
+ * surfaces (direct_gen) let the old textures, and with them the old
+ * surfaces, go. nil if Metal cannot read it.
+ */
+static id<MTLTexture> omacvm_direct_texture(IOSurfaceRef surf)
+{
+    unsigned gen = qatomic_read(&direct_gen);
+
+    if (gen != direct_tex_gen) {
+        for (int i = 0; i < DIRECT_TEXTURES; i++) {
+            [direct_tex[i].tex release];
+            direct_tex[i].tex = nil;
+            direct_tex[i].surf = NULL;
+        }
+        direct_tex_gen = gen;
+    }
+    for (int i = 0; i < DIRECT_TEXTURES; i++) {
+        if (direct_tex[i].surf == surf) {
+            return direct_tex[i].tex;
+        }
+    }
+    uint32_t f = IOSurfaceGetPixelFormat(surf);
+    bool half = f == 'RGhA' || f == '&RhA';
+    /* By name: Metal is not linked into QEMU. */
+    Class desc = NSClassFromString(@"MTLTextureDescriptor");
+    MTLTextureDescriptor *d =
+        [desc texture2DDescriptorWithPixelFormat:half ? MTLPixelFormatRGBA16Float :
+                                                        MTLPixelFormatBGRA8Unorm
+                                           width:IOSurfaceGetWidth(surf)
+                                          height:IOSurfaceGetHeight(surf)
+                                       mipmapped:NO];
+    [d setUsage:MTLTextureUsageShaderRead];
+    [d setStorageMode:MTLStorageModeShared];
+    id<MTLTexture> t = [direct_dev newTextureWithDescriptor:d iosurface:surf plane:0];
+    if (!t) {
+        return nil;
+    }
+    unsigned k = direct_tex_next++ % DIRECT_TEXTURES;
+    [direct_tex[k].tex release];
+    direct_tex[k].surf = surf;
+    direct_tex[k].tex = t;
+    return t;
+}
+
+static void omacvm_direct_fallback(const char *why);
+
+/*
+ * Commit thread, in place of setting the layer's contents: copy surf into
+ * the frame's drawable and present it. The surface stays in use (QEMU does
+ * not draw into it) until the GPU has copied it.
+ */
+static bool omacvm_direct_show(IOSurfaceRef surf)
+{
+    id<CAMetalDrawable> d = nil;
+
+    os_unfair_lock_lock(&direct_lock);
+    for (int i = 0; i < DIRECT_PENDING; i++) {
+        if (direct_pending[i].surf == surf) {
+            d = [direct_pending[i].drawable retain];
+            break;
+        }
+    }
+    os_unfair_lock_unlock(&direct_lock);
+    if (!d) {
+        return false;
+    }
+    id<MTLTexture> src = omacvm_direct_texture(surf);
+    id<MTLTexture> dst = [d texture];
+    if (!src) {
+        [d release];
+        omacvm_direct_fallback("Metal cannot read the frames");
+        return true;
+    }
+    if ([src width] != [dst width] || [src height] != [dst height] ||
+        [src pixelFormat] != [dst pixelFormat]) {
+        /* Cannot happen: a drawable that does not fit is dropped when taken. */
+        warn_report_once("cocoa: direct to display: a drawable of another size or kind");
+        [d release];
+        return true;
+    }
+    id<MTLCommandBuffer> cb = [direct_cq commandBuffer];
+    id<MTLBlitCommandEncoder> be = [cb blitCommandEncoder];
+    [be copyFromTexture:src toTexture:dst];
+    [be endEncoding];
+    [cb presentDrawable:d];
+    IOSurfaceIncrementUseCount(surf);
+    CFRetain(surf);
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        IOSurfaceDecrementUseCount(surf);
+        CFRelease(surf);
+    }];
+    [cb commit];
+    [d release];
+    omacvm_direct_status();
+    return true;
+}
+
+/* Any thread: surf's frame is done with (shown or dropped): let its drawable go. */
+static void omacvm_direct_put(IOSurfaceRef surf)
+{
+    id<CAMetalDrawable> d = nil;
+
+    os_unfair_lock_lock(&direct_lock);
+    for (int i = 0; i < DIRECT_PENDING; i++) {
+        if (direct_pending[i].surf == surf) {
+            d = direct_pending[i].drawable;
+            direct_pending[i].surf = NULL;
+            direct_pending[i].drawable = nil;
+            break;
+        }
+    }
+    os_unfair_lock_unlock(&direct_lock);
+    [d release];
+}
+
+/*
+ * Any thread: Metal could not read a frame. The plain layer from now on:
+ * frames still queued show from their surfaces as a layer's contents.
+ */
+static void omacvm_direct_fallback(const char *why)
+{
+    if (!qatomic_xchg(&present_direct, 0)) {
+        return;
+    }
+    warn_report("cocoa: direct to display: off for this run (%s); the plain "
+                "layer from now on", why);
+    omacvm_direct_drop_spare();
+    dispatch_async(dispatch_get_main_queue(), ^{
+        CALayer *old = [cocoaView layer];
+        CALayer *layer = [[CALayer alloc] init];
+        [layer setOpaque:YES];
+        [layer setBackgroundColor:CGColorGetConstantColor(kCGColorBlack)];
+        [layer setContentsGravity:[old contentsGravity]];
+        [layer setContentsScale:[old contentsScale]];
+        for (CALayer *sub in [[[old sublayers] copy] autorelease]) {
+            [sub removeFromSuperlayer];
+            [layer addSublayer:sub];
+        }
+        [cocoaView setLayer:layer];
+        [layer release];
+    });
+}
+
+/*
  * OmacVM, extra brightness (ADR 0050, ui/omacvm-bright.h): with the app's
  * switch (extraBrightness, read live) the guest's frames go through a
  * shader into half-float surfaces in extended linear sRGB, times a gain
@@ -8234,6 +8642,9 @@
     present_linear = linear;
     present_next = 0;
     omacvm_pd_reset(&present_pd, present_nsurf, present_pd.fw, present_pd.fh);
+    if (omacvm_direct_on()) {
+        omacvm_direct_alloc(w, h, deep, linear, packed);
+    }
     return true;
 }
 
@@ -8354,6 +8765,23 @@
             break;
         }
     }
+    id<CAMetalDrawable> drawable = nil;
+    if (i < present_nsurf && omacvm_direct_on()) {

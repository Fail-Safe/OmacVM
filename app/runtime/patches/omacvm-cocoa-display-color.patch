+/*
+ * Main thread: the window's display's colour space for the present; a
+ * change redraws the newest frame in it (omacvm_bright_bh: the same
+ * context and redraw).
+ */
+static void omacvm_dc_look(void)
+{
+    if (!present_ctx) {
+        return;
+    }
+    NSScreen *screen = [[cocoaView window] screen] ?: [NSScreen mainScreen];
+    CGColorSpaceRef cs = [[screen colorSpace] CGColorSpace];
+    bool changed;
+
+    os_unfair_lock_lock(&dc_lock);
+    changed = !(cs == dc_space || (cs && dc_space && CFEqual(cs, dc_space)));
+    if (changed) {
+        CGColorSpaceRelease(dc_space);
+        dc_space = cs ? CGColorSpaceRetain(cs) : NULL;
+    }
+    os_unfair_lock_unlock(&dc_lock);
+    if (changed) {
+        qatomic_inc(&dc_gen);
+        if (omacvm_bright_bh) {
+            qemu_bh_schedule(omacvm_bright_bh);
+        }
+    }
+}
+
 /* Main thread, once the GL present is chosen. */
 static void omacvm_bright_init(void)
 {
@@ -11028,8 +11271,17 @@ static void omacvm_bright_init(void)
                      queue:[NSOperationQueue mainQueue]
                 usingBlock:^(NSNotification *note) {
         omacvm_bright_look();
+        omacvm_dc_look();
+    }];
+    /* Display colour: the window's display, its profile (another one picked). */
+    [nc addObserverForName:NSWindowDidChangeScreenProfileNotification
+                    object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        omacvm_dc_look();
     }];
     omacvm_bright_look();
+    omacvm_dc_look();
 }
 

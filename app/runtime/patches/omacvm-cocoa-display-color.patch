+/*
+ * OmacVM, display colour (ui/omacvm-dispcolor.h): 8-bit SDR frames are
+ * converted to the window's display's colour space in the present pass
+ * and tagged with it, so WindowServer does not colour-match the window on
+ * every composite (a third of its GPU time for it on a MacBook Air).
+ * Main thread: dc_space follows the window's screen (and its profile),
+ * dc_gen counts the changes. QEMU thread: the table and its program for
+ * dc_gen, in present_ctx. OMACVM_GL_DISPLAY_COLOR=0 keeps the sRGB tag.
+ */
+static os_unfair_lock dc_lock = OS_UNFAIR_LOCK_INIT;
+static CGColorSpaceRef dc_space;       /* dc_lock: the window's display's space */
+static unsigned dc_gen;                /* qatomic: dc_space changed */
+static unsigned present_dc_gen;        /* QEMU thread: dc_gen the table was made for */
+static CGColorSpaceRef present_dc_cs;  /* QEMU thread: the table's space; NULL: none */
+static bool present_dc_srgb;           /* QEMU thread: the display is sRGB itself */
+static GLuint dc_table, dc_prog, dc_vao, dc_vbo;
+static GLint dc_u_flip;
+static int dc_made;                    /* QEMU thread: program 1 made, -1 failed */
+static int dc_off = -1;                /* OMACVM_GL_DISPLAY_COLOR=0 */
 

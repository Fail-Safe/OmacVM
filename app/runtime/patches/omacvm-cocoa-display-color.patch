+/*
+ * QEMU thread, present_ctx current: the table for the display's space
+ * now (dc_gen), and the program once. present_dc_cs stays NULL (no
+ * conversion, the sRGB tag) for an sRGB display, a space the table cannot
+ * follow (omacvm_dc_error) or any failure; qemu.log says which once per
+ * display.
+ */
+static void omacvm_dc_update(void)
+{
+    static const GLfloat quad[] = { -1, -1, 1, -1, -1, 1, 1, 1 };
+    unsigned gen = qatomic_read(&dc_gen);
+
+    if (gen == present_dc_gen) {
+        return;
+    }
+    present_dc_gen = gen;
+    os_unfair_lock_lock(&dc_lock);
+    CGColorSpaceRef cs = dc_space ? CGColorSpaceRetain(dc_space) : NULL;
+    os_unfair_lock_unlock(&dc_lock);
+    CGColorSpaceRelease(present_dc_cs);
+    present_dc_cs = NULL;
+    present_dc_srgb = false;
+    if (!cs) {
+        return;
+    }
+    CFStringRef cname = CGColorSpaceCopyName(cs);
+    char name[128] = "an unnamed profile";
+    if (cname) {
+        CFStringGetCString(cname, name, sizeof(name), kCFStringEncodingUTF8);
+        CFRelease(cname);
+    }
+    CGColorSpaceRef srgb = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    present_dc_srgb = CFEqual(cs, srgb);
+    CGColorSpaceRelease(srgb);
+    if (present_dc_srgb) {
+        info_report("cocoa: display colour: the display is sRGB, frames tagged sRGB");
+        CGColorSpaceRelease(cs);
+        return;
+    }
+    if (!dc_made) {
+        GLuint vs = omacvm_bright_shader(GL_VERTEX_SHADER, OMACVM_DC_VERT);
+        GLuint fs = omacvm_bright_shader(GL_FRAGMENT_SHADER, OMACVM_DC_FRAG);
+        GLint ok = 0;
+        if (vs && fs) {
+            dc_prog = glCreateProgram();
+            glAttachShader(dc_prog, vs);
+            glAttachShader(dc_prog, fs);
+            glBindAttribLocation(dc_prog, 0, "in_position");
+            glLinkProgram(dc_prog);
+            glGetProgramiv(dc_prog, GL_LINK_STATUS, &ok);
+        }
+        glDeleteShader(vs);
+        glDeleteShader(fs);
+        if (!ok) {
+            if (dc_prog) {
+                glDeleteProgram(dc_prog);
+                dc_prog = 0;
+            }
+            dc_made = -1;
+            warn_report("cocoa: display colour: no shader, frames tagged sRGB this run");
+        } else {
+            glUseProgram(dc_prog);
+            glUniform1i(glGetUniformLocation(dc_prog, "image"), 0);
+            glUniform1i(glGetUniformLocation(dc_prog, "table"), 1);
+            glUniform1f(glGetUniformLocation(dc_prog, "scale"), omacvm_dc_scale(OMACVM_DC_N));
+            glUniform1f(glGetUniformLocation(dc_prog, "offset"), omacvm_dc_offset(OMACVM_DC_N));
+            dc_u_flip = glGetUniformLocation(dc_prog, "yflip");
+            glUseProgram(0);
+            glGenVertexArrays(1, &dc_vao);
+            glBindVertexArray(dc_vao);
+            glGenBuffers(1, &dc_vbo);
+            glBindBuffer(GL_ARRAY_BUFFER, dc_vbo);
+            glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+            glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, 0);
+            glEnableVertexAttribArray(0);
+            glBindBuffer(GL_ARRAY_BUFFER, 0);
+            glBindVertexArray(0);
+            glGenTextures(1, &dc_table);
+            dc_made = 1;
+        }
+    }
+    if (dc_made < 0) {
+        CGColorSpaceRelease(cs);
+        return;
+    }
+    size_t entries = (size_t)OMACVM_DC_N * OMACVM_DC_N * OMACVM_DC_N;
+    uint16_t *table = g_new0(uint16_t, entries * 4);
+    int err = omacvm_dc_fill(cs, OMACVM_DC_N, table) ?
+              omacvm_dc_error(cs, OMACVM_DC_N, table) : -1;
+    if (err < 0 || err > OMACVM_DC_MAX_ERR) {
+        info_report("cocoa: display colour: %s %s, frames tagged sRGB", name,
+                    err < 0 ? "is no RGB profile" :
+                    "is not followed closely enough by the table");
+        g_free(table);
+        CGColorSpaceRelease(cs);
+        return;
+    }
+    glBindTexture(GL_TEXTURE_3D, dc_table);
+    glTexImage3D(GL_TEXTURE_3D, 0, GL_RGBA16, OMACVM_DC_N, OMACVM_DC_N, OMACVM_DC_N, 0,
+                 GL_RGBA, GL_UNSIGNED_SHORT, table);
+    glTexParameteri(GL_TEXTURE_3D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_3D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_3D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_3D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_3D, GL_TEXTURE_WRAP_R, GL_CLAMP_TO_EDGE);
+    glBindTexture(GL_TEXTURE_3D, 0);
+    g_free(table);
+    present_dc_cs = cs;
+    info_report("cocoa: display colour: frames converted to %s here (table %d codes "
+                "from macOS's own conversion), tagged with it", name, err);
+}
+
+/* QEMU thread, BQL held: whether this frame goes into display-space surfaces. */
+static bool omacvm_dc_wanted_now(bool deep, bool linear, bool splash)
+{
+    if (dc_off < 0) {
+        dc_off = omacvm_dc_env_off(getenv("OMACVM_GL_DISPLAY_COLOR"));
+        if (dc_off) {
+            info_report("cocoa: display colour: off (OMACVM_GL_DISPLAY_COLOR), frames tagged sRGB");
+        }
+    }
+    if (!dc_off) {
+        omacvm_dc_update();
+    }
+    OmacvmDcState st = {
+        .tagged = cocoa_gl_present_tagged(),
+        .deep = deep,
+        .linear = linear,
+        .off = dc_off,
+        .known = present_dc_cs != NULL,
+        .display_srgb = present_dc_srgb,
+        .failed = dc_made < 0,
+        .splash = splash,
+    };
+    return omacvm_dc_wanted(&st);
+}
+
+/*
+ * QEMU thread, present_ctx current: the bound texture into the bound
+ * framebuffer as QEMU's blit (flip as its texture_blit_flip), converted to
+ * the display's space through the table. False without it.
+ */
+static bool omacvm_dc_blit(bool flip)
+{
+    if (dc_made <= 0 || !present_dc_cs) {
+        return false;
+    }
+    glUseProgram(dc_prog);
+    glUniform1f(dc_u_flip, flip ? 1.0f : -1.0f);
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_3D, dc_table);
+    glActiveTexture(GL_TEXTURE0);
+    glBindVertexArray(dc_vao);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glBindVertexArray(0);
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_3D, 0);
+    glActiveTexture(GL_TEXTURE0);
+    glUseProgram(0);
+    return true;
+}

 static bool present_deep_failed;
 static unsigned present_next;
+/*
+ * OmacVM: partial present. A surface keeps what it showed last, so only what
+ * the guest changed since then is drawn into it again: the union of the
+ * guest's flush rects since that surface's last draw (omacvm-present-damage.h).
+ * Full draws for anything else: new surfaces, another frame size, scaling,
+ * the boot logo, another colour path, a scanout buffer not seen among the
+ * last few (a compositor's own buffers rotate; a new one, as when a client's
+ * buffer goes straight to the screen, may come with damage that is not
+ * relative to what was shown). Only the guest's GL scanout, at its full size,
+ * is drawn in part. Off (every frame in full, as before) unless
+ * OMACVM_GL_PRESENT_DAMAGE=1 or =check, until a VM run shows partial draws
+ * right (ADR 0051). Guests before Linux 7.4 flush the whole plane on every
+ * page flip; a buffer flushed again (boot console, a TTY) comes with real
+ * rects.
+ */
+static OmacvmPresentDamage present_pd;
+static int present_damage_on = -1;
+static uint64_t present_pd_sig = UINT64_MAX;
+#define PRESENT_PD_IDS 4
+static uint32_t present_pd_ids[PRESENT_PD_IDS];   /* scanout ids seen last */
+static bool present_pd_logged;
+/*
+ * The guest switched the scanout to another buffer and has not flushed it
+ * yet: its rects come with that flush, so a present before it (timer, new
+ * surfaces, the window showing again) draws the new buffer in full.
+ */
+static bool present_pd_unflushed;
+static GLuint present_pd_check_tex, present_pd_check_fbo;
+static uint32_t present_pd_check_w, present_pd_check_h;
+static bool present_pd_check_half;
+static uint64_t present_pd_checks, present_pd_bad, present_pd_frames_part;
+
+/*
+ * OMACVM_GL_PRESENT_DAMAGE=check (tests): every 30th frame drawn in part is
+ * also drawn in full into a texture of its own, and the two are compared
+ * pixel for pixel (colour only: the window ignores alpha). The texture has
+ * the format of surface N, read from it (half float for 'RGhA': deep colour
+ * and extra brightness; else 8-bit; the check mode keeps surfaces plain), so
+ * both round alike when read back. qemu.log gets each frame that differs and every 100th
+ * check. Reads back two whole frames: for tests, not for use. QEMU thread, present_ctx current, SRC bound as the
+ * present left it.
+ */
+static void cocoa_gl_present_pd_check(GLuint src, bool flip, unsigned n,
+                                      OmacvmPDRect box)
+{
+    uint32_t w = present_w, h = present_h;
+    size_t bytes = (size_t)w * h * 4;
+    bool half = IOSurfaceGetPixelFormat(present_surf[n]) == 'RGhA';
+    if (present_pd_check_w != w || present_pd_check_h != h ||
+        present_pd_check_half != half) {
+        if (present_pd_check_tex) {
+            glDeleteTextures(1, &present_pd_check_tex);
+        }
+        if (!present_pd_check_fbo) {
+            glGenFramebuffers(1, &present_pd_check_fbo);
+        }
+        glGenTextures(1, &present_pd_check_tex);
+        glBindTexture(GL_TEXTURE_RECTANGLE, present_pd_check_tex);
+        glTexImage2D(GL_TEXTURE_RECTANGLE, 0,
+                     half ? GL_RGBA16F : GL_RGBA8, w, h, 0,
+                     half ? GL_RGBA : GL_BGRA,
+                     half ? GL_HALF_FLOAT : GL_UNSIGNED_INT_8_8_8_8_REV,
+                     NULL);
+        glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+        present_pd_check_w = w;
+        present_pd_check_h = h;
+        present_pd_check_half = half;
+    }
+    uint8_t *a = g_try_malloc(bytes), *b = g_try_malloc(bytes);
+    if (!a || !b) {
+        g_free(a);
+        g_free(b);
+        return;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, present_pd_check_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, present_pd_check_tex, 0);
+    glViewport(0, 0, w, h);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE);
+    glBindTexture(GL_TEXTURE_2D, src);
+    qemu_gl_run_texture_blit(present_gls, flip);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(0, 0, w, h, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, b);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, present_tex[n], 0);
+    glReadPixels(0, 0, w, h, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, a);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, 0, 0);
+    uint64_t diff = 0;
+    uint32_t x0 = w, y0 = h, x1 = 0, y1 = 0;
+    for (uint32_t y = 0; y < h; y++) {
+        const uint8_t *pa = a + (size_t)y * w * 4, *pb = b + (size_t)y * w * 4;
+        for (uint32_t x = 0; x < w; x++) {
+            if (pa[4 * x] != pb[4 * x] || pa[4 * x + 1] != pb[4 * x + 1] ||
+                pa[4 * x + 2] != pb[4 * x + 2]) {
+                diff++;
+                x0 = MIN(x0, x); y0 = MIN(y0, y);
+                x1 = MAX(x1, x); y1 = MAX(y1, y);
+            }
+        }
+    }
+    g_free(a);
+    g_free(b);
+    present_pd_checks++;
+    if (diff) {
+        present_pd_bad++;
+        warn_report("cocoa: present check: %" PRIu64 " pixels differ in %ux%u+%u+%u "
+                    "(drawn: %ux%u+%u+%u; %" PRIu64 " of %" PRIu64 " checks bad)",
+                    diff, x1 - x0 + 1, y1 - y0 + 1, x0, y0, box.w, box.h, box.x, box.y,
+                    present_pd_bad, present_pd_checks);
+    } else if (present_pd_checks % 100 == 0) {
+        info_report("cocoa: present check: %" PRIu64 " of %" PRIu64 " checks bad",
+                    present_pd_bad, present_pd_checks);
+    }
+}
 static dispatch_queue_t present_queue;
 static QEMUTimer *present_timer;
 static int64_t present_last_ns;
@@ -7988,6 +8109,7 @@
     present_deep = deep;
     present_linear = linear;
     present_next = 0;
+    omacvm_pd_reset(&present_pd, present_nsurf, present_pd.fw, present_pd.fh);
     return true;
 }
 
@@ -8124,6 +8246,50 @@
     unsigned n = (present_next + i) % present_nsurf;
     present_next = (n + 1) % present_nsurf;
 
+    /* OmacVM: what surface n needs (partial present, see present_pd). */
+    if (present_damage_on < 0) {
+        const char *e = getenv("OMACVM_GL_PRESENT_DAMAGE");
+        present_damage_on = e && !strcmp(e, "1") ? 1 : e && !strcmp(e, "check") ? 2 : 0;
+        info_report("cocoa: present: %s", !present_damage_on ?
+                    "every frame in full (OMACVM_GL_PRESENT_DAMAGE=1: what changed only)" :
+                    present_damage_on == 2 ?
+                    "what changed only, checked against full draws (OMACVM_GL_PRESENT_DAMAGE=check)" :
+                    "what changed only (the guest's flush rects, OMACVM_GL_PRESENT_DAMAGE=1)");
+    }
+    uint64_t pd_sig = (uint64_t)deep | (uint64_t)pq << 1 | (uint64_t)boost << 2 |
+                      (uint64_t)linear << 3 | (uint64_t)flip << 4 |
+                      (uint64_t)splash << 5 | (uint64_t)!gl_scanout_borrow << 6 |
+                      (uint64_t)(w != present_w || h != present_h) << 7 |
+                      (uint64_t)(uint32_t)(boost ? gain : 0) << 32;
+    omacvm_pd_frame(&present_pd, w, h);
+    if (pd_sig != present_pd_sig) {
+        omacvm_pd_all_full(&present_pd);
+        present_pd_sig = pd_sig;
+    }
+    bool pd_known = false;
+    if (gl_scanout_borrow) {
+        for (unsigned k = 0; k < PRESENT_PD_IDS; k++) {
+            pd_known |= present_pd_ids[k] == gl_scanout_id;
+        }
+        if (!pd_known) {
+            omacvm_pd_all_full(&present_pd);
+            memmove(present_pd_ids + 1, present_pd_ids,
+                    sizeof(present_pd_ids) - sizeof(present_pd_ids[0]));
+            present_pd_ids[0] = gl_scanout_id;
+        }
+    }
+    OmacvmPDRect pd;
+    bool part = omacvm_pd_take(&present_pd, n, &pd) && present_damage_on &&
+                gl_scanout_borrow && !present_pd_unflushed && !splash && !boost &&
+                w == present_w && h == present_h &&
+                gl_scanout_x == 0 && gl_scanout_y == 0 &&
+                gl_scanout_w == w && gl_scanout_h == h;
+    if (part && !present_pd_logged) {
+        present_pd_logged = true;
+        info_report("cocoa: present: first frame drawn in part (%ux%u of %ux%u)",
+                    pd.w, pd.h, w, h);
+    }
+
     glBindFramebuffer(GL_FRAMEBUFFER, present_fbo);
     glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
                            GL_TEXTURE_RECTANGLE, present_tex[n], 0);
@@ -8132,8 +8298,18 @@
     glDisable(GL_SCISSOR_TEST);
     /* The guest's alpha means nothing here: the window is opaque. */
     glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
-    glClearColor(0, 0, 0, 1);
-    glClear(GL_COLOR_BUFFER_BIT);
+    if (part) {
+        /*
+         * Only the changed box, and no clear: the rest of the surface is
+         * the frame already (its alpha too). The surface's first row is the
+         * top of the frame, as the guest's rects count.
+         */

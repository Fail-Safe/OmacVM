+/* The decoded picture's size, at most the frame VideoToolbox returned: VP9's and
+ * AV1's frame size from the picture description. VideoToolbox's AV1 frame is as large
+ * as the format description, and that comes from Mesa's max_width/max_height (the
+ * guest surface's size, rounded up to 16 by Chrome's coded size): the rows past the
+ * picture are not the picture's, and vrend fills the guest's planes past this size
+ * with the picture's last row and column instead (virgl-video-plane-edge.patch). */
+static void picture_size(const struct virgl_video_codec *codec, CVPixelBufferRef pix,
+                         uint32_t *w, uint32_t *h)
+{
+    uint32_t fw = 0, fh = 0;
+
+    *w = (uint32_t)CVPixelBufferGetWidth(pix);
+    *h = (uint32_t)CVPixelBufferGetHeight(pix);
+    if (!codec->have_desc)
+        return;
+    if (codec->kind == VT_KIND_AV1) {
+        fw = codec->desc.av1.picture_parameter.frame_width;
+        fh = codec->desc.av1.picture_parameter.frame_height;
+    } else if (codec->kind == VT_KIND_VP9) {
+        fw = codec->desc.vp9.picture_parameter.frame_width;
+        fh = codec->desc.vp9.picture_parameter.frame_height;
+    }
+    if (fw && fw < *w)
+        *w = fw;
+    if (fh && fh < *h)
+        *h = fh;
 }
 
 /* Hand the decoded picture to vrend, which copies it into the plane textures. */

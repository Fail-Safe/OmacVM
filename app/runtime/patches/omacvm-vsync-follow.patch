--- /dev/null
+++ b/ui/omacvm-vsync.c
@@ -0,0 +1,171 @@
+/*
+ * OmacVM: the Mac display's refresh grid for the guest's vblanks
+ * (ui/omacvm-vsync.h). The present's display link publishes it, virtio-gpu
+ * hands it to a guest that asks, in the guest's counter.
+ */
+#include "qemu/osdep.h"
+#include "qemu/atomic.h"
+#include "qemu/thread.h"
+#include "ui/omacvm-vsync.h"
+
+#ifdef __APPLE__
+#include <mach/mach_time.h>
+#include <os/lock.h>
+/*
+ * os_unfair_lock, not a spin lock: the commit queue runs at a high QoS and
+ * the holder may be a lower one (the main loop, hvf); this lock lends its
+ * priority to the holder.
+ */
+static os_unfair_lock vsync_lock = OS_UNFAIR_LOCK_INIT;
+#define vsync_take() os_unfair_lock_lock(&vsync_lock)
+#define vsync_give() os_unfair_lock_unlock(&vsync_lock)
+#else
+static QemuSpin vsync_lock;         /* zero: unlocked */
+#define vsync_take() qemu_spin_lock(&vsync_lock)
+#define vsync_give() qemu_spin_unlock(&vsync_lock)
+#endif
+
+static bool vsync_ready;
+static int64_t vsync_vblank_ns;     /* a vblank the guest should have */
+static uint64_t vsync_period_ps;
+static int64_t vsync_published_ns;  /* when the link last published it */
+static bool vsync_offset_known;
+static uint64_t vsync_offset;       /* guest counter = mach time - this */
+static int64_t vsync_asked;
+static bool vsync_locked;           /* the last ask: the guest's frames are on the grid */
+/* The grid the guest got last: its timer follows that one, not a newer. */
+static bool ans_valid;
+static int64_t ans_vblank_ns, ans_moved_ns;
+static uint64_t ans_period_ps;
+
+#ifdef __APPLE__
+static mach_timebase_info_data_t timebase(void)
+{
+    static mach_timebase_info_data_t tb;
+
+    if (!qatomic_read(&tb.denom)) {
+        mach_timebase_info_data_t t;
+        mach_timebase_info(&t);
+        qatomic_set(&tb.numer, t.numer);
+        qatomic_set(&tb.denom, t.denom);
+    }
+    return tb;
+}
+#endif
+
+int64_t omacvm_vsync_now_ns(void)
+{
+#ifdef __APPLE__
+    mach_timebase_info_data_t tb = timebase();
+    return (int64_t)((__int128)mach_absolute_time() * tb.numer / tb.denom);
+#else
+    return 0;
+#endif
+}
+
+void omacvm_vsync_publish(int64_t vblank_ns, uint64_t period_ps)
+{
+    int64_t now = omacvm_vsync_now_ns();
+
+    vsync_take();
+    vsync_vblank_ns = vblank_ns;
+    vsync_period_ps = period_ps;
+    vsync_published_ns = now;
+    vsync_ready = period_ps != 0;
+    vsync_give();
+}
+
+void omacvm_vsync_withdraw(void)
+{
+    vsync_take();
+    vsync_ready = false;
+    vsync_locked = false;
+    ans_valid = false;
+    vsync_give();
+}
+
+void omacvm_vsync_set_counter_offset(uint64_t mach_offset)
+{
+    vsync_take();
+    vsync_offset = mach_offset;
+    vsync_offset_known = true;
+    vsync_give();
+}
+
+bool omacvm_vsync_for_guest(uint32_t flags, uint32_t version, uint32_t mode_period_ns,
+                            uint64_t *counter, uint64_t *period_ps)
+{
+#ifdef __APPLE__
+    int64_t now = omacvm_vsync_now_ns();
+    mach_timebase_info_data_t tb = timebase();
+    bool ok;
+    int64_t at = 0;
+    uint64_t offset = 0;
+
+    vsync_take();
+    vsync_asked = now;
+    /* An old grid (the link paused) is no grid: the guest asks again soon. */
+    ok = vsync_ready && vsync_offset_known &&
+         omacvm_vsync_grid_fresh(now, vsync_published_ns);
+    /* Its frames count as on the grid only when it says so, at the grid's rate. */
+    vsync_locked = ok && ans_valid &&
+                   omacvm_vsync_guest_locked(flags, version, mode_period_ns, vsync_period_ps);
+    if (ok) {
+        at = omacvm_vsync_next(vsync_vblank_ns, vsync_period_ps, now);
+        *period_ps = vsync_period_ps;
+        offset = vsync_offset;
+        /* A grid that moved (by more than 0.2 ms): the guest's timer comes after it over a few vblanks. */
+        int64_t d = ans_valid && ans_period_ps ?
+                    omacvm_vsync_next(ans_vblank_ns, ans_period_ps, at) - at : 0;
+        int64_t p = (int64_t)(ans_period_ps / 1000);
+        if (!ans_valid || ans_period_ps != vsync_period_ps || MIN(d, p - d) > 200000) {
+            ans_moved_ns = now;
+        }
+        ans_valid = true;
+        ans_vblank_ns = at;
+        ans_period_ps = vsync_period_ps;
+    } else {
+        ans_valid = false;
+    }
+    vsync_give();
+    if (ok) {
+        *counter = (uint64_t)((__int128)at * tb.denom / tb.numer) - offset;
+    }
+    return ok;
+#else
+    return false;
+#endif
+}
+
+bool omacvm_vsync_locked(void)
+{
+    bool l;
+
+    vsync_take();
+    l = vsync_locked;
+    vsync_give();
+    return l;
+}
+
+bool omacvm_vsync_answered(int64_t *vblank_ns, uint64_t *period_ps, int64_t *moved_ns)
+{
+    bool ok;
+
+    vsync_take();
+    ok = ans_valid;
+    *vblank_ns = ans_vblank_ns;
+    *period_ps = ans_period_ps;
+    *moved_ns = ans_moved_ns;
+    vsync_give();
+    return ok;
+}
+
+int64_t omacvm_vsync_asked_ns(void)
+{
+    int64_t t;
+
+    vsync_take();
+    t = vsync_asked;
+    vsync_give();
+    return t;
+}

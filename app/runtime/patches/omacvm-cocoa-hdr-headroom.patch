+/*
+ * OmacVM, HDR (ADR 0049): while QEMU shows the guest's 10-bit frames as PQ,
+ * the main output's entry in the layout carries "edr": the headroom of the
+ * window's display now (1 = SDR white; omacvm-edr.h), which the guest
+ * tone-maps into (omacvm-display-sync); 0 = PQ cannot be shown this run
+ * (half-float surfaces failed, or the CAOpenGLLayer path). Main thread: a
+ * look once a second while HDR is wanted and the guest's display agent is
+ * there (NSScreen's current headroom follows the panel's brightness, and
+ * QEMU's layer asks for EDR, so it reads the real value); a new value goes
+ * out when it moved by 10 % or more. OMACVM_GL_EDR_HEADROOM=potential sends
+ * the display's most instead of its current headroom.
+ */
+static double omacvm_edr_sent = -1;
+static dispatch_source_t omacvm_edr_timer;
+
+static double omacvm_edr_now(void)
+{
+    if (!cocoa_gl_present_hdr_wanted()) {
+        return -1;
+    }
+    if (!present_ctx || qatomic_read(&present_deep_failed)) {
+        return 0;
+    }
+    NSScreen *s = [[cocoaView window] screen];
+    if (!s) {
+        return omacvm_edr_sent > 0 ? omacvm_edr_sent : 1;
+    }
+    const char *e = getenv("OMACVM_GL_EDR_HEADROOM");
+    return omacvm_edr_value([s maximumExtendedDynamicRangeColorComponentValue],
+                            [s maximumPotentialExtendedDynamicRangeColorComponentValue],
+                            e && !strcmp(e, "potential"));
+}
+
+/* What the layout carries from now on; true when it is new. */
+static bool omacvm_edr_set(double v)
+{
+    if (!omacvm_edr_moved(omacvm_edr_sent, v)) {
+        return false;
+    }
+    if (omacvm_edr_sent < 0 || (omacvm_edr_sent == 0) != (v == 0)) {
+        info_report("cocoa: HDR: %s", v > 0 ? "PQ, the guest tone-maps to the display's headroom"
+                                            : "PQ cannot be shown, the guest stays SDR");
+    }
+    omacvm_edr_sent = v;
+    return true;
+}
+
+static void omacvm_edr_look(void)
+{
+    if (omacvm_edr_set(omacvm_edr_now())) {
+        omacvm_send_layout();
+    }
+}
+
+static void omacvm_edr_watch(void)
+{
+    if (omacvm_edr_timer || !cocoa_gl_present_hdr_wanted()) {
+        return;
+    }
+    omacvm_edr_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
+                                              dispatch_get_main_queue());
+    dispatch_source_set_timer(omacvm_edr_timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
+                              NSEC_PER_SEC, NSEC_PER_SEC / 2);
+    dispatch_source_set_event_handler(omacvm_edr_timer, ^{
+        if (omacvm_guest_ready) {
+            omacvm_edr_look();
+        }
+    });
+    dispatch_resume(omacvm_edr_timer);
+}
+
 static void omacvm_send_layout(void)
 {
     NSMutableArray *outputs = [NSMutableArray array];

+/*
+ * OmacVM: DMA from the sound's own thread (audio-rt.c), which never takes
+ * the BQL: guest RAM only, straight through the PCI device's address space
+ * under RCU. Anything else (MMIO would need the BQL) fails the transfer.
+ */
+static bool intel_hda_dma_ram(IntelHDAState *d, dma_addr_t addr, void *buf,
+                              dma_addr_t len, bool to_guest)
+{
+    const MemTxAttrs attrs = { .memory = true };
+    AddressSpace *as = pci_get_address_space(&d->pci);
+    uint8_t *b = buf;
+
+    RCU_READ_LOCK_GUARD();
+    smp_mb();
+    while (len > 0) {
+        hwaddr xlat, l = len;
+        MemoryRegion *mr = address_space_translate(as, addr, &xlat, &l,
+                                                   to_guest, attrs);
+
+        if (!l || !memory_access_is_direct(mr, to_guest, attrs)) {
+            return false;
+        }
+        uint8_t *p = (uint8_t *)memory_region_get_ram_ptr(mr) + xlat;
+        if (to_guest) {
+            memcpy(p, b, l);
+            memory_region_set_dirty(mr, xlat, l);
+        } else {
+            memcpy(b, p, l);
+        }
+        addr += l;
+        b += l;
+        len -= l;
+    }
+    return true;
+}
+
+static void intel_hda_update_irq(IntelHDAState *d);

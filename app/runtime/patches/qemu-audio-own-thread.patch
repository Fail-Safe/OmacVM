+/*
+ * OmacVM: the sound's own real-time thread.
+ *
+ * QEMU moves the sound in its main loop: the HDA codec's DMA timers and the
+ * mixer's audio timer. The main loop also runs the VM's GPU (virgl), which
+ * holds it for 50-200 ms when the guest compiles shaders, and it competes
+ * with every vCPU for the Mac's cores. A late main loop is a break in the
+ * sound unless a buffer covers it.
+ *
+ * With OMACVM_AUDIO_THREAD=1 those timers become ticks on one thread of
+ * their own, at real-time priority (macOS time-constraint policy, else
+ * user-interactive QoS), that never takes the BQL. Everything the ticks
+ * touch (the mixer, the HDA codec's streams, the HDA controller's stream
+ * registers) is guarded by one recursive lock, audio_rt_lock(), which the
+ * device's MMIO handlers and the audio backend API take too. Lock order:
+ * BQL, then the audio lock, then a backend's own locks (SDL's device lock).
+ * The thread never takes the BQL: the HDA controller does its DMA to guest
+ * RAM directly and raises its interrupt from a bottom half.
+ *
+ * The thread sleeps while no tick is registered or the VM is stopped.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/audio.h"
+#include "qemu/error-report.h"
+#include "qemu/thread.h"
+#include "qemu/rcu.h"
+#include "qemu/timer.h"
+#include "system/runstate.h"
+#ifdef __APPLE__
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/thread_policy.h>
+#include <pthread.h>
+#endif
+
+#define AUDIO_RT_MAX_TICKS 16
+
+static QemuRecMutex audio_rt_mutex;
+static QemuSemaphore audio_rt_wake;
+static QemuThread audio_rt_thread;
+static bool audio_rt_started;
+static bool audio_rt_vm_running;
+static int64_t audio_rt_period_ns = 1 * SCALE_MS;
+/* Under the audio lock. */
+static AudioRtTick *audio_rt_ticks[AUDIO_RT_MAX_TICKS];
+static int audio_rt_nticks;
+static bool audio_rt_sleeping;
+
+static void audio_rt_init_once(void)
+{
+    static bool done;
+
+    if (!done) {
+        done = true;
+        qemu_rec_mutex_init(&audio_rt_mutex);
+        qemu_sem_init(&audio_rt_wake, 0);
+    }
+}
+
+bool audio_rt_enabled(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *v = g_getenv("OMACVM_AUDIO_THREAD");
+        const char *p = g_getenv("OMACVM_AUDIO_THREAD_PERIOD_US");
+
+        on = v && !strcmp(v, "1");
+        /* Which way the sound moves (qemu.log, omacvm check "sound timing"). */
+        info_report("OmacVM: sound path: %s", on ? "own audio thread"
+                                                 : "QEMU's main loop");
+        if (p) {
+            int64_t us = g_ascii_strtoll(p, NULL, 10);
+            if (us >= 250 && us <= 10000) {
+                audio_rt_period_ns = us * SCALE_US;
+            }
+        }
+        audio_rt_init_once();
+    }
+    return on;
+}
+
+void audio_rt_lock(void)
+{
+    if (audio_rt_enabled()) {
+        qemu_rec_mutex_lock(&audio_rt_mutex);
+    }
+}
+
+void audio_rt_unlock(void)
+{
+    if (audio_rt_enabled()) {
+        qemu_rec_mutex_unlock(&audio_rt_mutex);
+    }
+}
+
+bool audio_rt_on_thread(void)
+{
+    return audio_rt_started && qemu_thread_is_self(&audio_rt_thread);
+}
+
+#ifdef __APPLE__
+static const char *audio_rt_set_priority(void)
+{
+    mach_timebase_info_data_t tb;
+    struct thread_time_constraint_policy pol;
+    double ns_to_abs;
+
+    mach_timebase_info(&tb);
+    ns_to_abs = (double)tb.denom / tb.numer;
+    /* Every period; done in a quarter of it, at the latest by its end. */
+    pol.period = (uint32_t)(audio_rt_period_ns * ns_to_abs);
+    pol.computation = (uint32_t)(audio_rt_period_ns / 4 * ns_to_abs);
+    pol.constraint = (uint32_t)(audio_rt_period_ns * ns_to_abs);
+    pol.preemptible = 1;
+    if (thread_policy_set(mach_thread_self(), THREAD_TIME_CONSTRAINT_POLICY,
+                          (thread_policy_t)&pol,
+                          THREAD_TIME_CONSTRAINT_POLICY_COUNT) == KERN_SUCCESS) {
+        return "time-constraint";
+    }
+    if (pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0) == 0) {
+        return "user-interactive QoS";
+    }
+    return "default priority";
+}
+
+static void audio_rt_sleep_until(int64_t deadline_ns)
+{
+    static mach_timebase_info_data_t tb;
+
+    if (!tb.denom) {
+        mach_timebase_info(&tb);
+    }
+    int64_t now = get_clock();
+    if (deadline_ns > now) {
+        mach_wait_until(mach_absolute_time() +
+                        (uint64_t)((deadline_ns - now) * tb.denom / tb.numer));
+    }
+}
+#else
+static const char *audio_rt_set_priority(void)
+{
+    return "default priority";
+}
+
+static void audio_rt_sleep_until(int64_t deadline_ns)
+{
+    int64_t now = get_clock();
+    if (deadline_ns > now) {
+        g_usleep((deadline_ns - now) / SCALE_US);
+    }
+}
+#endif
+
+static void *audio_rt_run(void *opaque)
+{
+    AudioRtTick *now_ticks[AUDIO_RT_MAX_TICKS];
+    int64_t next = get_clock();
+
+    rcu_register_thread();
+    info_report("OmacVM: sound: own audio thread, %s, every %" PRId64 " us",
+                audio_rt_set_priority(), audio_rt_period_ns / SCALE_US);
+    for (;;) {
+        int n, i;
+
+        qemu_rec_mutex_lock(&audio_rt_mutex);
+        if (!audio_rt_nticks || !audio_rt_vm_running) {
+            audio_rt_sleeping = true;
+            qemu_rec_mutex_unlock(&audio_rt_mutex);
+            qemu_sem_wait(&audio_rt_wake);
+            next = get_clock();
+            continue;
+        }
+        /* A tick may add or remove ticks: run the ones registered now. */
+        n = audio_rt_nticks;
+        memcpy(now_ticks, audio_rt_ticks, n * sizeof(now_ticks[0]));
+        for (i = 0; i < n; i++) {
+            if (now_ticks[i]->registered) {
+                now_ticks[i]->fn(now_ticks[i]->opaque);
+            }
+        }
+        qemu_rec_mutex_unlock(&audio_rt_mutex);
+
+        next += audio_rt_period_ns;
+        int64_t t = get_clock();
+        if (next < t - 20 * SCALE_MS) {
+            /* Late by far more than a period (the Mac slept): start over. */
+            next = t;
+        }
+        audio_rt_sleep_until(next);
+    }
+    return NULL;
+}
+
+/* Under the audio lock. */
+static void audio_rt_kick(void)
+{
+    if (audio_rt_sleeping && audio_rt_nticks && audio_rt_vm_running) {
+        audio_rt_sleeping = false;
+        qemu_sem_post(&audio_rt_wake);
+    }
+}
+
+static void audio_rt_vm_state(void *opaque, bool running, RunState state)
+{
+    qemu_rec_mutex_lock(&audio_rt_mutex);
+    audio_rt_vm_running = running;
+    audio_rt_kick();
+    qemu_rec_mutex_unlock(&audio_rt_mutex);
+}
+
+void audio_rt_tick_add(AudioRtTick *t, void (*fn)(void *), void *opaque)
+{
+    assert(audio_rt_enabled());
+    qemu_rec_mutex_lock(&audio_rt_mutex);
+    if (!audio_rt_started) {
+        audio_rt_started = true;
+        audio_rt_vm_running = runstate_is_running();
+        audio_rt_sleeping = true;
+        qemu_add_vm_change_state_handler(audio_rt_vm_state, NULL);
+        qemu_thread_create(&audio_rt_thread, "omacvm-audio", audio_rt_run,
+                           NULL, QEMU_THREAD_DETACHED);
+    }
+    t->fn = fn;
+    t->opaque = opaque;
+    if (!t->registered) {
+        if (audio_rt_nticks == AUDIO_RT_MAX_TICKS) {
+            error_report("OmacVM: sound: too many audio ticks");
+            abort();
+        }
+        t->registered = true;
+        audio_rt_ticks[audio_rt_nticks++] = t;
+    }
+    audio_rt_kick();
+    qemu_rec_mutex_unlock(&audio_rt_mutex);
+}
+
+void audio_rt_tick_del(AudioRtTick *t)
+{
+    int i;
+
+    if (!audio_rt_enabled()) {
+        return;
+    }
+    qemu_rec_mutex_lock(&audio_rt_mutex);
+    if (t->registered) {
+        t->registered = false;
+        for (i = 0; i < audio_rt_nticks; i++) {
+            if (audio_rt_ticks[i] == t) {
+                audio_rt_ticks[i] = audio_rt_ticks[--audio_rt_nticks];
+                break;
+            }
+        }
+    }
+    qemu_rec_mutex_unlock(&audio_rt_mutex);
+}
+
+int64_t audio_rt_period(void)
+{
+    return audio_rt_period_ns;
+}

+/*
+ * OmacVM, the sound's own thread (audio-rt.c): the DMA no longer waits for
+ * the main loop. But while the main loop holds the BQL (virgl compiling
+ * shaders: 50-200 ms), a vCPU that leaves the guest waits for it, and the
+ * guest's PipeWire may not run: then the guest's sound clock pauses
+ * (as with a stalled main loop before) and QEMU's own buffer plays on.
+ * Afterwards the buffer refills 1/8 faster than real time (1/32 on the main
+ * loop), so stalls in a row (an app opening) do not add up.
+ * OMACVM_AUDIO_BQL_PAUSE_MS (default 10, 0 = never pause) and
+ * OMACVM_AUDIO_REFILL_DIV (default 8) are for measurements.
+ */
+static int64_t hda_bql_pause_ns(void)
+{
+    static int64_t v = -1;
+
+    if (v < 0) {
+        const char *e = g_getenv("OMACVM_AUDIO_BQL_PAUSE_MS");
+        v = (e ? g_ascii_strtoll(e, NULL, 10) : 10) * SCALE_MS;
+        if (v < 0) {
+            v = 0;
+        }
+    }
+    return v;
+}
+
+static int64_t hda_pace_div(void)
+{
+    static int64_t v = -1;
+
+    if (v < 0) {
+        const char *e = g_getenv("OMACVM_AUDIO_REFILL_DIV");
+        v = audio_rt_enabled() ? 8 : 32;
+        if (e && g_ascii_strtoll(e, NULL, 10) >= 2) {
+            v = g_ascii_strtoll(e, NULL, 10);
+        }
+    }
+    return v;
+}

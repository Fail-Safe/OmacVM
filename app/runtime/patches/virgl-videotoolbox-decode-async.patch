+/* Waits up to TIMEOUT_MS until every picture sent up to SEQ was given back
+ * (the sync thread); false on time out. */
+bool virgl_video_decode_wait(uint64_t seq, uint32_t timeout_ms)
+{
+    struct timespec ts;
+    bool done;
+
+    if (!seq)
+        return true;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += timeout_ms / 1000;
+    ts.tv_nsec += (long)(timeout_ms % 1000) * 1000000L;
+    if (ts.tv_nsec >= 1000000000L) {
+        ts.tv_sec++;
+        ts.tv_nsec -= 1000000000L;
+    }
+    pthread_mutex_lock(&dec_lock);
+    while (dec_open <= seq)
+        if (pthread_cond_timedwait(&dec_cond, &dec_lock, &ts))
+            break;
+    done = dec_open > seq;
+    pthread_mutex_unlock(&dec_lock);
+    return done;
+}

 /* ------------------------------------------------------------------------ */
+/* Decoding beside vrend's thread                                            */
+/* ------------------------------------------------------------------------ */
+
+/* vrend's thread is QEMU's GPU thread: every guest context's commands wait
+ * while it waits. END_FRAME sends the picture to the media engine and returns
+ * (at most VT_DEC_MAX_JOBS per decoder in flight); its output callback marks
+ * the job and wakes vrend's thread (callbacks->encode_wake), whose poll copies
+ * the pictures that are in into the guest's planes, oldest first. Before the
+ * guest's planes are read or written (a draw samples them, a blit, a copy, a
+ * transfer), vrend gives every picture in flight back first, waiting for each
+ * (virgl_video_decode_finish; callbacks->decode_pending marks the targets).
+ * A fence made after an END_FRAME signals only after that picture is in the
+ * guest's planes (the sync thread waits for it after the GL fence).
+ * A picture the media engine has had for 1 s is given up (logged).
+ * OMACVM_VIDEO_DECODE_SYNC=1: END_FRAME waits for the picture, as before.
+ * Threading: dec_lock covers the jobs' slots (number, output fields) and
+ * dec_open; dj_head, dj_count and dec_list belong to vrend's thread. */
+static pthread_mutex_t dec_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t dec_cond = PTHREAD_COND_INITIALIZER;
+static uint64_t dec_seq_last;           /* the last picture sent (vrend's thread) */
+static uint64_t dec_open = 1;           /* the oldest picture not given back yet */
+static struct virgl_video_codec *dec_list;
+
+static bool dec_async(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("OMACVM_VIDEO_DECODE_SYNC");
+        on = !(e && *e == '1');
+        if (!on)
+            virgl_info("vt-video: decoding waits for each picture (OMACVM_VIDEO_DECODE_SYNC=1)\n");
+    }
+    return on;
+}
+
+/* VideoToolbox's output thread: the picture of job SEQ is in. */
+static void dec_output(struct virgl_video_codec *codec, uint64_t seq, OSStatus status,
+                       CVImageBufferRef image)
+{
+    bool found = false;
+
+    pthread_mutex_lock(&dec_lock);
+    for (unsigned i = 0; i < VT_DEC_MAX_JOBS; i++) {
+        struct dec_job *job = &codec->djobs[i];
+        if (job->seq == seq && !job->out) {
+            job->out = true;
+            job->status = status;
+            job->out_ns = now_ns();
+            if (status == noErr && image)
+                job->pix = CVPixelBufferRetain(image);
+            found = true;
+            break;
+        }
+    }
+    if (found)
+        pthread_cond_broadcast(&dec_cond);
+    pthread_mutex_unlock(&dec_lock);
+    /* a job given up meanwhile: nothing to do */
+    if (found && callbacks && callbacks->encode_wake)
+        callbacks->encode_wake();
+}
+
+static void dec_update_open(void)
+{
+    uint64_t open = dec_seq_last + 1;
+
+    for (struct virgl_video_codec *c = dec_list; c; c = c->dec_next)
+        if (c->dj_count && c->djobs[c->dj_head].seq < open)
+            open = c->djobs[c->dj_head].seq;
+    pthread_mutex_lock(&dec_lock);
+    if (open != dec_open) {
+        dec_open = open;
+        pthread_cond_broadcast(&dec_cond);
+    }
+    pthread_mutex_unlock(&dec_lock);
+}
+
+static void dec_deadline(struct timespec *ts, uint64_t sent_ns)
+{
+    uint64_t now = now_ns(), end = sent_ns + 1000000000ull;
+    uint64_t left = end > now ? end - now : 0;
+
+    clock_gettime(CLOCK_REALTIME, ts);
+    ts->tv_sec += (time_t)(left / 1000000000ull);
+    ts->tv_nsec += (long)(left % 1000000000ull);
+    if (ts->tv_nsec >= 1000000000L) {
+        ts->tv_sec++;
+        ts->tv_nsec -= 1000000000L;
+    }
+}
+
+/* The oldest job back: its picture into the guest's planes, its slot free. Its
+ * picture not in yet: false, or (BLOCK) wait for it up to 1 s after it was sent. */
+static bool dec_give_back(struct virgl_video_codec *codec, bool block)
+{
+    struct dec_job *job = &codec->djobs[codec->dj_head];
+    struct virgl_video_buffer *target;
+    CVPixelBufferRef pix;
+    OSStatus status;
+    uint32_t fw, fh;
+    uint64_t took;
+    bool out;
+
+    pthread_mutex_lock(&dec_lock);
+    if (!job->out && block) {
+        struct timespec ts;
+        dec_deadline(&ts, job->sent_ns);
+        while (!job->out)
+            if (pthread_cond_timedwait(&dec_cond, &dec_lock, &ts))
+                break;
+    }
+    out = job->out;
+    if (!out && !block) {
+        pthread_mutex_unlock(&dec_lock);
+        return false;
+    }
+    pix = job->pix;
+    status = job->status;
+    target = job->target;
+    fw = job->frame_w;
+    fh = job->frame_h;
+    took = out ? job->out_ns - job->sent_ns : 0;
+    memset(job, 0, sizeof(*job));       /* seq 0: a late output finds nothing */
+    pthread_mutex_unlock(&dec_lock);
+    codec->dj_head = (codec->dj_head + 1) % VT_DEC_MAX_JOBS;
+    codec->dj_count--;
+
+    if (!out) {
+        if (codec->errors++ < 5)
+            virgl_warn("vt-video: no picture from the media engine after 1 s: given up\n");
+    } else if (status != noErr || !pix) {
+        if (codec->errors++ < 20)
+            virgl_warn("vt-video: decode failed: %d\n", (int)status);
+    } else {
+        codec->ns_decode += took;
+        if (took > codec->ns_decode_max)
+            codec->ns_decode_max = took;
+        if (target)
+            deliver_picture(codec, target, pix, fw, fh);
+    }
+    if (pix)
+        CVPixelBufferRelease(pix);
+    if (target && callbacks && callbacks->decode_pending)
+        callbacks->decode_pending(codec, target, false);
+    return true;
+}
+
+static void dec_deliver(struct virgl_video_codec *codec, bool block)
+{
+    while (codec->dj_count && dec_give_back(codec, block))
+        ;
+    dec_update_open();
+}
+
+/* One picture's compressed data to the media engine; its picture goes into
+ * TARGET's planes now (OMACVM_VIDEO_DECODE_SYNC=1) or when it is in. */
+static void decode_picture(struct virgl_video_codec *codec, const uint8_t *data, size_t size,
+                           struct virgl_video_buffer *target)
+{
+    struct dec_job *job;
+    uint32_t fw, fh;
+
+    if (!dec_async()) {
+        if (decode_sample(codec, data, size, NULL))
+            deliver_output(codec, target);
+        return;
+    }
+    dec_deliver(codec, false);

+/* Main thread: the guest's pointer on this output, placed as its frames are stretched. */
+- (void)omacvmPointerLayout
+{
+    OmacVMHeadPointer *p = &omacvm_head_ptr[output];
+    NSSize v = [self bounds].size;
+    /* hidden while the Mac's cursor shows it, as the main window's cursor layer */
+    bool mac = omacvm_hwc_layer_hidden(&omacvm_hwc, [cocoaView omacvmAbsolute]);
+    OmacVMHeadPointerFrame f = omacvm_head_pointer_frame(p->on && p->image && !mac,
+                                                         p->x, p->y, p->w, p->h,
+                                                         p->ow, p->oh, v.width, v.height);
+
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    if ((CGImageRef)[pointerLayer contents] != p->image) {
+        [pointerLayer setContents:(id)p->image];
+    }
+    if (f.shown) {
+        [pointerLayer setBounds:CGRectMake(0, 0, f.w, f.h)];
+        [pointerLayer setPosition:CGPointMake(f.x, f.y)];
+    }
+    [pointerLayer setHidden:!f.shown];
+    [CATransaction commit];
 }
 
+- (void)setFrameSize:(NSSize)size
+{

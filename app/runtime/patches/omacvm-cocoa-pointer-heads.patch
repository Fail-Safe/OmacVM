+ * The guest's pointer on this output: the window's pointer layer, or with
+ * the hidden macPointer the Mac's own cursor (see omacvm_hwc_take).
+ */
 static void omacvm_head_mouse_set(DisplayChangeListener *dcl, int x, int y, bool on)
 {

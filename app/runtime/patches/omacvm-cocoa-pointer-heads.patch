-/* The guest's pointer on this output (hardware cursor only, see omacvm_hwc_take). */
+/*
+ * OmacVM (#554): the guest's pointer over the window of this output, as the
+ * main window's cursor layer shows it over the main one. With "Pointer on
+ * its own layer" every output has a cursor plane and the guest draws no
+ * pointer into its frames: without this layer the other displays showed
+ * none. Per output, main thread only; kept while the output has no window,
+ * for its next one.
+ */
+typedef struct OmacVMHeadPointer {
+    CGImageRef image;   /* the guest's image (a copy), premultiplied */
+    int w, h;           /* its size, guest pixels */
+    int x, y;           /* its top left on the output, from the guest */
+    bool on;            /* the guest shows the plane */
+    int ow, oh;         /* the output's size */
+} OmacVMHeadPointer;
+
+static OmacVMHeadPointer omacvm_head_ptr[OMACVM_MAX_OUTPUTS];
+static void omacvm_head_pointer_apply(int output);
+
+/* Main thread, BQL: the guest's new image for this output (NULL: none). */
+static void omacvm_head_pointer_image(int output, QEMUCursor *c)
+{
+    OmacVMHeadPointer *p = &omacvm_head_ptr[output];
+    CGImageRef image = NULL;
+
+    if (c && c->width > 0 && c->height > 0) {
+        /* copied: virtio-gpu writes the next image into the same buffer */
+        CFDataRef data = CFDataCreate(NULL, (const UInt8 *)c->data,
+                                      (CFIndex)c->width * c->height * 4);
+        CGDataProviderRef provider = CGDataProviderCreateWithCFData(data);
+        CGColorSpaceRef space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+
+        /* premultiplied, as virtio-gpu sends it (as the main window's layer) */
+        image = CGImageCreate(c->width, c->height, 8, 32, c->width * 4, space,
+                              kCGBitmapByteOrder32Little | kCGImageAlphaPremultipliedFirst,
+                              provider, NULL, false, kCGRenderingIntentDefault);
+        CGColorSpaceRelease(space);
+        CGDataProviderRelease(provider);
+        CFRelease(data);
+    }
+    CGImageRelease(p->image);
+    p->image = image;
+    p->w = image ? c->width : 0;
+    p->h = image ? c->height : 0;
+    omacvm_head_pointer_apply(output);
+}
+
+/* From a listener callback: the output's size now, for its window's pointer layer. */
+static void omacvm_head_pointer_size(DisplayChangeListener *dcl)
+{
+    int output = ((OmacVMHead *)dcl)->output;
+    int ow = qemu_console_get_width(dcl->con, 0);
+    int oh = qemu_console_get_height(dcl->con, 0);
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        omacvm_head_ptr[output].ow = ow;
+        omacvm_head_ptr[output].oh = oh;
+        omacvm_head_pointer_apply(output);
+    });
+}
+

-/* The view of an extra output: the pointer goes to the guest through the main view. */
+/*
+ * The view of an extra output: the pointer goes to the guest through the
+ * main view; the guest's pointer shows on its pointer layer (#554).
+ */
 @interface OmacVMHeadView : NSView
 {
 @public
     int output;
+    CALayer *pointerLayer;
 }
+- (void)omacvmPointerLayout;
 @end
 
 @implementation OmacVMHeadView
@@ -11097,10 +11187,50 @@
         [self setLayer:layer];
         [layer release];
 #endif
+        /* Above the frames, as the main window's cursor layer: top left at the plane's. */
+        pointerLayer = [[CALayer alloc] init];
+        [pointerLayer setAnchorPoint:CGPointMake(0, 1)];
+        [pointerLayer setZPosition:1];
+        [pointerLayer setHidden:YES];
+        [[self layer] addSublayer:pointerLayer];
     }
     return self;
+}
+
+- (void)dealloc
+{
+    [pointerLayer release];
+    [super dealloc];
+}
+
+/* Main thread: the guest's pointer on this output, placed as its frames are stretched. */
+- (void)omacvmPointerLayout
+{
+    OmacVMHeadPointer *p = &omacvm_head_ptr[output];
+    NSSize v = [self bounds].size;
+    OmacVMHeadPointerFrame f = omacvm_head_pointer_frame(p->on && p->image && !omacvm_hwc.on,
+                                                         p->x, p->y, p->w, p->h,
+                                                         p->ow, p->oh, v.width, v.height);
+
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    if ((CGImageRef)[pointerLayer contents] != p->image) {
+        [pointerLayer setContents:(id)p->image];
+    }
+    if (f.shown) {
+        [pointerLayer setBounds:CGRectMake(0, 0, f.w, f.h)];
+        [pointerLayer setPosition:CGPointMake(f.x, f.y)];
+    }
+    [pointerLayer setHidden:!f.shown];
+    [CATransaction commit];
 }
 
+- (void)setFrameSize:(NSSize)size
+{
+    [super setFrameSize:size];
+    [self omacvmPointerLayout];
+}
+

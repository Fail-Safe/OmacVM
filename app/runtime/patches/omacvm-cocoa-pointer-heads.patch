+/* Main thread, BQL: the guest's new image for this output (NULL: none). */
+static void omacvm_head_pointer_image(int output, QEMUCursor *c)
+{
+    OmacVMHeadPointer *p = &omacvm_head_ptr[output];
+    CGImageRef image = NULL;
+
+    if (c && c->width > 0 && c->height > 0) {
+        /* copied: virtio-gpu writes the next image into the same buffer */
+        CFDataRef data = CFDataCreate(NULL, (const UInt8 *)c->data,
+                                      (CFIndex)c->width * c->height * 4);
+        CGDataProviderRef provider = CGDataProviderCreateWithCFData(data);
+        CGColorSpaceRef space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+
+        /* premultiplied, as virtio-gpu sends it (as the main window's layer) */
+        image = CGImageCreate(c->width, c->height, 8, 32, c->width * 4, space,
+                              kCGBitmapByteOrder32Little | kCGImageAlphaPremultipliedFirst,
+                              provider, NULL, false, kCGRenderingIntentDefault);
+        CGColorSpaceRelease(space);
+        CGDataProviderRelease(provider);
+        CFRelease(data);
+    }
+    CGImageRelease(p->image);
+    p->image = image;
+    p->w = image ? c->width : 0;
+    p->h = image ? c->height : 0;
+    omacvm_head_pointer_apply(output);
+}

     });
 }
 
+/* QEMU's thread: the output is off, so is its pointer (a window made again shows none). */
+static void omacvm_head_pointer_off(DisplayChangeListener *dcl)
+{
+    int output = ((OmacVMHead *)dcl)->output;
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        omacvm_head_ptr[output].on = false;
+        omacvm_head_pointer_apply(output);
+    });
+}
+
+/*
+ * The guest's pointer on this output: the window's pointer layer, and with
+ * the hidden macPointer also the Mac's own cursor (see omacvm_hwc_take),
+ * as for the main window (cocoa_mouse_set).
+ */
+static void omacvm_head_mouse_set(DisplayChangeListener *dcl, int x, int y, bool on)
+{
+    int output = ((OmacVMHead *)dcl)->output;
+    bool hwc = omacvm_hwc.on;
+
+    omacvm_head_pointer_size(dcl);
+    dispatch_async(dispatch_get_main_queue(), ^{
+        OmacVMHeadPointer *p = &omacvm_head_ptr[output];
+
+        p->x = x;
+        p->y = y;
+        p->on = on;
+        if (hwc) {
+            omacvm_hwc_show(&omacvm_hwc, output, on);
+            [cocoaView omacvmUpdateMacCursor];
+        }
+        omacvm_head_pointer_apply(output);
+    });
+}

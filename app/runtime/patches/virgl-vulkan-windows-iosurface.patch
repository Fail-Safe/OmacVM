+/* OmacVM (ADR 0047): 4-byte unit i of the IOSurface is texel (i % row, i / row) of the
+ * RECTANGLE texture (BGRA8 as GL reads it); the image's row y starts at unit
+ * first + y * stride. mode 0: 4-byte pixels as GL reads BGRA, 1: RGBA-ordered ones,
+ * 2: 8-byte pixels of four half floats (taken apart bit by bit: exact). */
+static const char restride_vs[] =
+   "void main() {\n"
+   "   gl_Position = vec4(float((gl_VertexID & 1) * 4 - 1), float((gl_VertexID >> 1) * 4 - 1), 0.0, 1.0);\n"
+   "}\n";
+static const char restride_fs[] =
+   "uniform sampler2DRect src;\n"
+   "uniform int first;\n"
+   "uniform int stride;\n"
+   "uniform int row;\n"
+   "uniform int mode;\n"
+   "out vec4 color;\n"
+   "vec4 at(int i) { return texelFetch(src, ivec2(i % row, i / row)); }\n"
+   "uvec4 bytes(int i) { vec4 c = round(at(i) * 255.0); return uvec4(c.b, c.g, c.r, c.a); }\n"
+   "float half_float(uint h) {\n"
+   "   uint s = (h >> 15u) << 31u, e = (h >> 10u) & 31u, m = h & 1023u;\n"
+   "   if (e == 0u) return uintBitsToFloat(s) + uintBitsToFloat(s | 0x3f800000u) * float(m) * exp2(-24.0);\n"
+   "   if (e == 31u) return uintBitsToFloat(s | 0x7f800000u | (m << 13u));\n"
+   "   return uintBitsToFloat(s | ((e + 112u) << 23u) | (m << 13u));\n"
+   "}\n"
+   "void main() {\n"
+   "   ivec2 p = ivec2(gl_FragCoord.xy);\n"
+   "   if (mode == 2) {\n"
+   "      int i = first + p.y * stride + p.x * 2;\n"
+   "      uvec4 a = bytes(i), b = bytes(i + 1);\n"
+   "      color = vec4(half_float(a.x | (a.y << 8u)), half_float(a.z | (a.w << 8u)),\n"
+   "                   half_float(b.x | (b.y << 8u)), half_float(b.z | (b.w << 8u)));\n"
+   "   } else {\n"
+   "      vec4 c = at(first + p.y * stride + p.x);\n"
+   "      color = mode == 1 ? c.bgra : c;\n"
+   "   }\n"
+   "}\n";
+
+static bool restride_init(struct vrend_blitter_ctx *blit_ctx)
+{
+   if (blit_ctx->restride_prog)
+      return true;
+   if (blit_ctx->use_gles || blit_ctx->glsl_ver < 400)
+      return false;
+
+   GLuint vs = blit_shader_build_and_check(blit_ctx, GL_VERTEX_SHADER, restride_vs);
+   GLuint fs = blit_shader_build_and_check(blit_ctx, GL_FRAGMENT_SHADER, restride_fs);
+   GLuint prog = (vs && fs) ? glCreateProgram() : 0;
+   if (prog) {
+      glAttachShader(prog, vs);
+      glAttachShader(prog, fs);
+      glBindFragDataLocation(prog, 0, "color");
+      if (!blit_shader_link_and_check(prog))
+         prog = 0;
+   }
+   if (vs)
+      glDeleteShader(vs);
+   if (fs)
+      glDeleteShader(fs);
+   if (!prog)
+      return false;

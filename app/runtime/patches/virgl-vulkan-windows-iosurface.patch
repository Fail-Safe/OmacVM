+ * 4-byte units; mode: see vrend_blitter.c. False: nothing was drawn. */
+/* OmacVM (ADR 0047): an image (offset and stride in bytes, width x height pixels of bpp
+ * bytes) lies inside a RECTANGLE texture of rect_width x rect_height 4-byte texels, and
+ * the shader's 32-bit texel numbers cannot overflow. */
+static inline bool
+vrend_iosurface_layout_ok(uint64_t offset, uint64_t stride, uint32_t width, uint32_t height,
+                          uint32_t bpp, uint32_t rect_width, uint32_t rect_height)
+{
+   const uint64_t texels = (uint64_t)rect_width * rect_height;
+   const uint64_t limit = texels * 4;
+   const uint64_t row = (uint64_t)width * bpp;
+   if (!width || !height || !texels || texels > INT32_MAX || (bpp != 4 && bpp != 8) ||
+       offset % 4 || stride % 4 || stride < row || offset > limit || row > limit - offset)
+      return false;
+   /* the rows after the first, without overflowing */
+   return height == 1 || (uint64_t)(height - 1) <= (limit - offset - row) / stride;
+}

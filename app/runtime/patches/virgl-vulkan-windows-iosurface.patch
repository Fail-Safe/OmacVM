+static bool vkr_iosurface_windows_env;
+
+static void
+vkr_iosurface_windows_read_env(void)
+{
+   const char *env = getenv("OMACVM_VK_WINDOWS");
+   vkr_iosurface_windows_env = env && !strcmp(env, "iosurface");
+}
+
+bool
+vkr_iosurface_windows_wanted(void)
+{
+   static once_flag once = ONCE_FLAG_INIT;
+   call_once(&once, vkr_iosurface_windows_read_env);
+   return vkr_iosurface_windows_env;
+}
+
+/* OmacVM (ADR 0047): window buffers as IOSurfaces only on KosmicKrisp (MoltenVK has
+ * the extension too, but its window path is not this one), with the host memory
+ * import turned on; said once per process when it was asked for. */
+static void
+vkr_device_init_iosurface_windows(struct vkr_device *dev)
+{
+   struct vkr_physical_device *physical_dev = dev->physical_device;
+   struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+   static atomic_bool told;
+   const char *why = NULL;
+
+   if (!vkr_iosurface_windows_wanted())
+      return;
+   if (!physical_dev->EXT_external_memory_host || !physical_dev->is_metal_export_supported) {
+      why = "the Vulkan driver cannot import host memory";
+   } else {
+      VkPhysicalDeviceDriverProperties driver_props = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES,
+      };
+      VkPhysicalDeviceProperties2 props2 = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+         .pNext = &driver_props,
+      };
+      vk->GetPhysicalDeviceProperties2(physical_dev->base.handle.physical_device, &props2);
+      dev->GetMemoryHostPointerPropertiesEXT = (PFN_vkGetMemoryHostPointerPropertiesEXT)
+         vk->GetDeviceProcAddr(dev->base.handle.device, "vkGetMemoryHostPointerPropertiesEXT");
+      if (driver_props.driverID != VK_DRIVER_ID_MESA_KOSMICKRISP)
+         why = "the Vulkan driver is not KosmicKrisp";
+      else if (!dev->GetMemoryHostPointerPropertiesEXT)
+         why = "the Vulkan driver has no vkGetMemoryHostPointerPropertiesEXT";
+   }
+   dev->iosurface_windows = !why;
+   if (!atomic_exchange(&told, true)) {
+      if (why)
+         vkr_log("Vulkan windows are copied (no IOSurfaces: %s)", why);
+      else
+         vkr_log("Vulkan windows are IOSurfaces (OMACVM_VK_WINDOWS=iosurface)");
+   }
+}
+

@@ -170,6 +228,14 @@ vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
       exts[ext_count++] = VK_EXT_EXTERNAL_MEMORY_METAL_EXTENSION_NAME;
    if (physical_dev->KHR_portability_subset)
       exts[ext_count++] = VK_KHR_PORTABILITY_SUBSET_EXTENSION_NAME;
+   /* OmacVM: host memory import for Vulkan window buffers (vkr_device_memory.c) */
+   bool host_memory = physical_dev->EXT_external_memory_host;
+   for (uint32_t i = 0; host_memory && i < ext_count; i++) {
+      if (!strcmp(exts[i], VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME))
+         host_memory = false; /* the guest asked for it itself */
+   }
+   if (host_memory)
+      exts[ext_count++] = VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME;
 
    ((VkDeviceCreateInfo *)args->pCreateInfo)->ppEnabledExtensionNames = exts;
    ((VkDeviceCreateInfo *)args->pCreateInfo)->enabledExtensionCount = ext_count;
@@ -224,6 +290,7 @@ vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
    }
 

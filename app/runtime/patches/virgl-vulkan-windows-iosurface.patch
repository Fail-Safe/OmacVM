+   glUseProgram(prog);
+   glUniform1i(glGetUniformLocation(prog, "src"), 0);
+   glUseProgram(0);
+   blit_ctx->restride_first = glGetUniformLocation(prog, "first");
+   blit_ctx->restride_stride = glGetUniformLocation(prog, "stride");
+   blit_ctx->restride_row = glGetUniformLocation(prog, "row");
+   blit_ctx->restride_mode = glGetUniformLocation(prog, "mode");
+   glGenVertexArrays(1, &blit_ctx->restride_vao);
+   glGenFramebuffers(1, &blit_ctx->restride_fb);
+   blit_ctx->restride_prog = prog;
+   return true;
+}

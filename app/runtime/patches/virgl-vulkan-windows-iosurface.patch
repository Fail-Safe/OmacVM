diff --git a/src/venus/vkr_device_memory.c b/src/venus/vkr_device_memory.c
index ba6453e..f7cbebb 100644
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -7,9 +7,184 @@
 
 #include "venus-protocol/vn_protocol_renderer_transport.h"
 
+#include "vkr_buffer.h"
+#include "vkr_device.h"
 #include "vkr_device_memory_gen.h"
 #include "vkr_physical_device.h"
 
+#ifdef __APPLE__
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOSurface/IOSurfaceRef.h>
+#include <unistd.h>
+
+/*
+ * OmacVM (ADR 0047): a Vulkan window's frames reach the compositor through a buffer
+ * Mesa's WSI exports as a dma-buf (the PRIME blit target). Made of a Metal heap, macOS
+ * OpenGL cannot see it, and vrend copied every frame on the CPU. With
+ * OMACVM_VK_WINDOWS=iosurface on KosmicKrisp (vkr_device.c) such a buffer's memory is
+ * an IOSurface instead, imported into the driver as host memory: vrend binds the same
+ * pages to OpenGL. Its layout is not known yet (the compositor tells it later), so the
+ * IOSurface is rows of VKR_IOSURFACE_ROW_BYTES and vrend re-strides it on the GPU.
+ * Lifetime: the memory, the vkr resource, the virgl resource and vrend's texture each
+ * hold a reference; the memory's is dropped only after the device's queues passed its
+ * vkFreeMemory (vkr_device_release_after_queues).
+ */
+#define VKR_IOSURFACE_ROW_PIXELS 4096u
+#define VKR_IOSURFACE_ROW_BYTES (VKR_IOSURFACE_ROW_PIXELS * 4u)
+#define VKR_IOSURFACE_MAX_ROWS 16384u
+
+static CFNumberRef
+vkr_cf_number(int64_t value)
+{
+   return CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &value);
+}
+
+static IOSurfaceRef
+vkr_iosurface_create(uint64_t size, void **base, const char **why)
+{
+   const uint64_t rows = size / VKR_IOSURFACE_ROW_BYTES;
+   if (!rows || rows > VKR_IOSURFACE_MAX_ROWS || size % VKR_IOSURFACE_ROW_BYTES) {
+      *why = "its size is out of range";
+      return NULL;
+   }
+
+   const void *keys[] = { kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement,
+                          kIOSurfaceBytesPerRow, kIOSurfacePixelFormat, kIOSurfaceAllocSize };
+   const void *values[] = { vkr_cf_number(VKR_IOSURFACE_ROW_PIXELS), vkr_cf_number(rows),
+                            vkr_cf_number(4), vkr_cf_number(VKR_IOSURFACE_ROW_BYTES),
+                            vkr_cf_number('BGRA'), vkr_cf_number(size) };
+   CFDictionaryRef props = CFDictionaryCreate(kCFAllocatorDefault, keys, values, ARRAY_SIZE(keys),
+                                              &kCFTypeDictionaryKeyCallBacks,
+                                              &kCFTypeDictionaryValueCallBacks);
+   for (unsigned i = 0; i < ARRAY_SIZE(values); i++) {
+      if (values[i])
+         CFRelease(values[i]);
+   }
+   IOSurfaceRef surface = props ? IOSurfaceCreate(props) : NULL;
+   if (props)
+      CFRelease(props);
+   if (!surface) {
+      *why = "IOSurfaceCreate failed";
+      return NULL;
+   }
+
+   IOSurfaceLock(surface, 0, NULL);
+   *base = IOSurfaceGetBaseAddress(surface);
+   IOSurfaceUnlock(surface, 0, NULL);
+   if (!*base || (uintptr_t)*base % (uintptr_t)getpagesize() ||
+       IOSurfaceGetBytesPerRow(surface) != VKR_IOSURFACE_ROW_BYTES ||
+       IOSurfaceGetAllocSize(surface) < size) {
+      CFRelease(surface);
+      *why = "the IOSurface's layout is not the one asked for";
+      return NULL;
+   }
+   return surface;
+}
+
+/* What Mesa's WSI asks for its PRIME buffer: export as a dma-buf, dedicated to a buffer
+ * vkr_buffer.c made for host memory (a window buffer), nothing else in the chain. */
+static bool
+vkr_device_memory_is_window_buffer(const VkMemoryAllocateInfo *info)
+{
+   bool export_dma_buf = false;
+   const struct vkr_buffer *buffer = NULL;
+   for (const VkBaseInStructure *s = info->pNext; s; s = s->pNext) {
+      if (s->sType == VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO) {
+         export_dma_buf = ((const VkExportMemoryAllocateInfo *)s)->handleTypes ==
+                          VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+      } else if (s->sType == VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO) {
+         const VkMemoryDedicatedAllocateInfo *d = (const VkMemoryDedicatedAllocateInfo *)s;
+         if (d->image == VK_NULL_HANDLE && d->buffer != VK_NULL_HANDLE)
+            buffer = vkr_buffer_from_handle(d->buffer);
+      } else {
+         return false;
+      }
+   }
+   return export_dma_buf && buffer && buffer->window;
+}
+
+/* Allocates the memory as an IOSurface; false leaves everything as it was (the caller
+ * takes the normal path). */
+static bool
+vkr_device_memory_alloc_iosurface(struct vkr_context *ctx,
+                                  struct vn_command_vkAllocateMemory *args,
+                                  struct vkr_device *dev,
+                                  struct virgl_gpu_charge *charge,
+                                  uint32_t property_flags)
+{
+   static atomic_bool told_yes, told_no;
+   const VkMemoryAllocateInfo *info = args->pAllocateInfo;
+   const uint64_t size = align64(info->allocationSize, VKR_IOSURFACE_ROW_BYTES);
+   const char *why = NULL;
+   void *base = NULL;
+
+   IOSurfaceRef surface = vkr_iosurface_create(size, &base, &why);
+   if (!surface)
+      goto refused;
+
+   VkMemoryHostPointerPropertiesEXT props = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+   };
+   if (dev->GetMemoryHostPointerPropertiesEXT(
+          dev->base.handle.device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+          base, &props) != VK_SUCCESS ||
+       !(props.memoryTypeBits & (1u << info->memoryTypeIndex))) {
+      why = "the driver cannot import it into that memory type";
+      goto refused;
+   }
+
+   const VkImportMemoryHostPointerInfoEXT import = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+      .pHostPointer = base,
+   };
+   const VkMemoryAllocateInfo host_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &import,
+      .allocationSize = size,
+      .memoryTypeIndex = info->memoryTypeIndex,
+   };
+   struct vkr_device_memory *mem = vkr_context_alloc_object(
+      ctx, sizeof(*mem), VK_OBJECT_TYPE_DEVICE_MEMORY, args->pMemory);
+   if (!mem) {
+      why = "out of memory";
+      goto refused;
+   }
+   if (dev->proc_table.AllocateMemory(dev->base.handle.device, &host_info, NULL,
+                                      &mem->base.handle.device_memory) != VK_SUCCESS) {
+      free(mem);
+      why = "the driver did not import it";
+      goto refused;
+   }
+   vkr_device_add_object(ctx, dev, &mem->base);
+
+   mem->device = dev;
+   mem->might_export = true;
+   mem->property_flags = property_flags;
+   mem->valid_fd_types = 1 << VIRGL_RESOURCE_IOSURFACE;
+   mem->udmabuf_fd = -1;
+   mem->gbm_bo = NULL;
+   mem->allocation_size = size;
+   mem->memory_type_index = info->memoryTypeIndex;
+   mem->charge = charge;
+   mem->iosurface = (void *)surface;
+   args->ret = VK_SUCCESS;
+   if (!atomic_exchange(&told_yes, true))
+      vkr_log("Vulkan window buffers are IOSurfaces (first: %" PRIu64 " KB)", size >> 10);
+   return true;
+
+refused:
+   if (surface)
+      CFRelease(surface);
+   /* the heap path after this: the buffer was made for host memory, which KosmicKrisp
+    * does not check; only when IOSurfaces themselves fail (memory) */

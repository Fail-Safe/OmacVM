+
+   glBindFramebuffer(GL_FRAMEBUFFER, blit_ctx->restride_fb);
+   glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, dst_tex, 0);
+   const GLenum buffer = GL_COLOR_ATTACHMENT0;
+   glDrawBuffers(1, &buffer);
+   if (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+      glViewport(0, 0, width, height);
+      glDisable(GL_SCISSOR_TEST);
+      glDisable(GL_DEPTH_TEST);
+      glDisable(GL_STENCIL_TEST);
+      glDisable(GL_BLEND);
+      glDisable(GL_CULL_FACE);
+      glDisable(GL_RASTERIZER_DISCARD);
+      glDisable(GL_FRAMEBUFFER_SRGB); /* the bytes as they are, also into sRGB textures */
+      glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+      glUseProgram(blit_ctx->restride_prog);
+      glUniform1i(blit_ctx->restride_first, (GLint)first);
+      glUniform1i(blit_ctx->restride_stride, (GLint)stride);
+      glUniform1i(blit_ctx->restride_row, (GLint)row);
+      glUniform1i(blit_ctx->restride_mode, mode);
+      glActiveTexture(GL_TEXTURE0);
+      glBindTexture(GL_TEXTURE_RECTANGLE, rect_tex);
+      glBindVertexArray(blit_ctx->restride_vao);
+      glDrawArrays(GL_TRIANGLES, 0, 3);
+      glBindVertexArray(blit_ctx->vaoid);
+      glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+      glUseProgram(0);
+      ok = true;
+   }
+   glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+   glBindFramebuffer(GL_FRAMEBUFFER, 0);
+   return ok;
+}
+
+bool vrend_blitter_restride(virgl_gl_context back, GLuint dst_tex, unsigned width,
+                            unsigned height, GLuint rect_tex, unsigned row, uint32_t first,
+                            uint32_t stride, int mode)
+{
+   struct vrend_blitter_ctx *blit_ctx = &vrend_blit_ctx;
+
+   if (blit_ctx->restride_failed || !row || !width || !height)
+      return false;
+
+   /* the blitter's own context: none of the guest context's state is touched */
+   vrend_renderer_init_blit_ctx(blit_ctx);
+   bool ok = false;
+   if (!restride_init(blit_ctx)) {
+      blit_ctx->restride_failed = true;
+      virgl_error("virglrenderer: the Vulkan window re-stride shader cannot be built\n");
+   } else {
+      ok = restride_draw(blit_ctx, dst_tex, width, height, rect_tex, row, first, stride, mode);
+   }
+   vrend_sync_make_current(back);
+   return ok;
+}

From: OmacVM
Subject: [PATCH] vrend: fence waits also nap an eighth of the time waited (macOS)

What: the sync thread's fence wait on macOS (virgl-darwin-fence-wait.patch)
napped 50 us between tests for the first millisecond and then doubled each
nap up to 1 ms. Those doubled naps stay, and once a wait is past the first
millisecond the thread also wakes an eighth of the time waited after each
test (at least 50 us). A fence is now seen at most an eighth of its time
late and never later than before. From 8 ms on the doubled naps (1 ms)
come first again, so a long or stuck GPU job still wakes the thread about
1000 times a second.

Why: the doubled naps woke at 1.05, 1.1, 1.2, 1.4, 1.8, 2.6, 3.6 ms, and
most of the VM's GPU work per frame takes 1-3 ms on the Mac (Hyprland's
frame, a browser's): a fence done after 1.85 ms was answered at 2.6 ms.
QEMU's trace showed it (fence asked -> answered, Mac mini M4, a VM's typing
and pointer moves): the times bunched at 1.1-1.2, 1.8-1.9, 2.6-2.7 and
3.6-3.7 ms with almost nothing between. A guest that waits for each frame
(an app's glFinish, a compositor waiting for a client's buffer) waited that
much longer.

Measured (Mac mini M4, macOS 27, one test VM, A = the 3.2.0 runtime, B =
this one, runs interleaved A B A B, src/tests/input-latency-vm.sh --app):
- A frame loop that waits for each frame (glFinish, 1920x1080, guest
  frames of ~1.2-6 ms): median frame 1.90-1.96 -> 1.69-1.71 ms, 2.72-2.80 ->
  2.15-2.19, 3.77-4.09 -> 3.07-3.12, 4.85-5.15 -> 4.26-4.32: 13-27 % more
  frames a second; the 1.2 ms and 6 ms frames the same.
- Every guest fence of a typing and pointer session, asked -> answered: the
  ladder is gone (A: almost nothing at 2.3-2.5 ms, a peak at 2.6-2.8; B:
  even), mean lateness 200-250 -> 75-90 us (played on the real fences).
- Key and pointer to screen at 60 Hz: unchanged within the noise (key p50
  22.9/22.7 vs 21.8/24.2 ms, pointer 20.3/19.3 vs 20.6/19.0); QEMU's CPU the
  same (6 % typing, 32-35 % with the pointer moving).
Wake-ups per fence: 29 instead of 26 for a 2 ms one, 34 instead of 27 for
3 ms, 138 instead of 124 for 100 ms; on the real fences +5-9 % in a typing
and pointer session (about 20-30 more a second), +19 % in the frame loop
(which draws 20 % more frames).

Upstream: macOS-specific, goes with virgl-darwin-fence-wait.patch.
Test: Tests/virgl/test-fence-nap.c (build time, no GL: the schedule against
fences of 0.05-20 ms, never later than the doubled naps alone, at most an
eighth late past 1 ms, the wake-ups); src/tests/input-latency-vm.sh (the
fence times in QEMU's trace).

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 0ea17ed..240f124 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -106,7 +106,8 @@ const struct vrend_if_cbs *vrend_clicbs;
 /* The sync thread's fence wait on macOS (do_wait): busy for at most SPIN
  * after the thread last slept, then naps of NAP between tests; once a
  * fence has taken LONG, each nap doubles up to NAP_MAX, so a long or stuck
- * GPU job wakes the thread about 1000 times a second, not 20000. The spin
+ * GPU job wakes the thread about 1000 times a second, not 20000, with
+ * shorter naps between while the wait is short (fence_naps). The spin
  * counts from the last sleep, not per fence, so fences that finish back to
  * back cannot chain spins: the thread's time-constraint budget per wake
  * (BUDGET, thread_sync) covers the spin and the work around it. */
@@ -119,6 +120,47 @@ const struct vrend_if_cbs *vrend_clicbs;
 /* When the sync thread last woke from a sleep (only it reads or writes). */
 static uint64_t fence_awake_since;
 
+/* The naps of one fence wait (mach ticks). The doubled naps wake as before;
+ * once the wait is LONG, the thread also wakes an eighth of the time waited
+ * after each test (at least NAP), so a fence is seen at most an eighth of its
+ * time late, and never later than the doubled naps alone saw it. Those woke
+ * at 1.05, 1.1, 1.2, 1.4, 1.8, 2.6, 3.6 ms, and most of the VM's frames take
+ * 1-3 ms (Hyprland's, a browser's): a fence done after 1.85 ms was seen at
+ * 2.6 ms. From 8 ms on the doubled naps (1 ms) come first again: a long or
+ * stuck job wakes the thread about 1000 times a second, as before. */
+#define FENCE_NAP_SHARE 8
+struct fence_naps {
+   uint64_t t0, nap, next;             /* next: the doubled naps' wake-up, 0 = from the next test */
+   uint64_t nap_min, lng, nap_max;
+};
+
+static void fence_naps_start(struct fence_naps *s, uint64_t t0)
+{
+   s->t0 = t0;
+   s->nap = s->nap_min;
+   s->next = 0;
+}
+
+/* Before a nap, at NOW (after a test that found the fence not done): when to wake. */
+static uint64_t fence_naps_wake(struct fence_naps *s, uint64_t now)
+{
+   if (!s->next)
+      s->next = now + s->nap;
+   if (now - s->t0 <= s->lng)
+      return s->next;
+   return MIN2(s->next, now + MAX2((now - s->t0) / FENCE_NAP_SHARE, s->nap_min));
+}
+
+/* After waking at WAKE: the doubled naps go on from their own wake-ups only. */
+static void fence_naps_woke(struct fence_naps *s, uint64_t wake)
+{
+   if (wake < s->next)
+      return;
+   if (s->next - s->nap - s->t0 > s->lng && s->nap < s->nap_max)
+      s->nap = MIN2(s->nap * 2, s->nap_max);
+   s->next = 0;
+}
+
 /* While the render thread runs guest commands (virgl_renderer_submit_cmd),
  * a fence test on the sync thread takes Apple GL's share-group lock that the
  * render thread's GL calls take too; every collision parks the render thread
@@ -8412,9 +8454,12 @@ static bool do_wait(struct vrend_fence *fence, bool can_block)
          mach_timebase_info(&tb);
       uint64_t t0 = mach_absolute_time();
       const uint64_t spin = FENCE_SPIN_NS * tb.denom / tb.numer;
-      const uint64_t lng = FENCE_LONG_NS * tb.denom / tb.numer;
-      const uint64_t nap_max = FENCE_NAP_MAX_NS * tb.denom / tb.numer;
-      uint64_t nap = FENCE_NAP_NS * tb.denom / tb.numer;
+      struct fence_naps naps = {
+         .nap_min = FENCE_NAP_NS * tb.denom / tb.numer,
+         .lng = FENCE_LONG_NS * tb.denom / tb.numer,
+         .nap_max = FENCE_NAP_MAX_NS * tb.denom / tb.numer,
+      };
+      fence_naps_start(&naps, t0);
       for (;;) {
          GLenum glret = glClientWaitSync(fence->glsyncobj, 0, 0);
          if (glret == GL_WAIT_FAILED)
@@ -8426,15 +8471,15 @@ static bool do_wait(struct vrend_fence *fence, bool can_block)
             /* Afterwards the wait starts over: spin and short naps first. */
             fence_wait_render(now);
             t0 = fence_awake_since;
-            nap = FENCE_NAP_NS * tb.denom / tb.numer;
+            fence_naps_start(&naps, t0);
             continue;
          }
          if (now - t0 <= spin && now - fence_awake_since <= spin)
             continue;
-         mach_wait_until(now + nap);
+         const uint64_t wake = fence_naps_wake(&naps, now);
+         mach_wait_until(wake);
          fence_awake_since = mach_absolute_time();
-         if (now - t0 > lng && nap < nap_max)
-            nap = MIN2(nap * 2, nap_max);
+         fence_naps_woke(&naps, wake);
       }
    }
 #endif

+/*
+ * OmacVM, extra brightness (ADR 0050): the main thread's side. The switch
+ * is the app's own defaults key extraBrightness (QEMU runs as the app, so
+ * its standard defaults are the app's), watched with KVO, which also
+ * reports a change made by another process (the app's window, defaults
+ * write), and read again when the window is seen again or the app becomes
+ * active. A QEMU not started as the app takes OMACVM_EXTRA_BRIGHT=1.
+ * OMACVM_TEST_EDR="potential,headroom" stands in for the window's display
+ * (the app passes it to test builds only). The look runs every 250 ms
+ * while the switch is on, the window is seen and its display can show it,
+ * and stops otherwise: no wakeups while it is off.
+ */
+static int omacvm_bright_switch = -1;   /* main thread; -1 before omacvm_bright_init */
+static dispatch_source_t omacvm_bright_timer;
+static OmacVMBright omacvm_bright_now_state = OMACVM_BRIGHT_OFF;
+static int omacvm_bright_logged = -1;
+static double omacvm_bright_held_since;
+
+static bool omacvm_bright_as_app(void)
+{
+    return [[[NSBundle mainBundle] bundleIdentifier] hasPrefix:@"org.omacvm.app"];
+}
+
+static void omacvm_bright_read_switch(void)
+{
+    if (omacvm_bright_as_app()) {
+        CFPreferencesAppSynchronize((CFStringRef)[[NSBundle mainBundle] bundleIdentifier]);
+        omacvm_bright_switch = [[NSUserDefaults standardUserDefaults] boolForKey:@"extraBrightness"];
+    } else {
+        const char *e = getenv("OMACVM_EXTRA_BRIGHT");
+        omacvm_bright_switch = e && !strcmp(e, "1");
+    }
+}
+
+/* The window's display: false while it has none yet (and no test hook). */
+static bool omacvm_bright_screen(double *now, double *potential)
+{
+    static int hook = -1;
+    static double hook_p, hook_n;
+
+    if (hook < 0) {
+        const char *t = getenv("OMACVM_TEST_EDR");
+        hook = t && sscanf(t, "%lf,%lf", &hook_p, &hook_n) == 2;
+        if (hook) {
+            info_report("cocoa: extra brightness: display from OMACVM_TEST_EDR "
+                        "(potential %.2f, headroom %.2f)", hook_p, hook_n);
+        }
+    }
+    if (hook) {
+        *potential = hook_p;
+        *now = hook_n;
+        return true;
+    }
+    NSScreen *s = [[cocoaView window] screen];
+    if (!s) {
+        return false;
+    }
+    *now = [s maximumExtendedDynamicRangeColorComponentValue];
+    *potential = [s maximumPotentialExtendedDynamicRangeColorComponentValue];
+    return true;
+}
+
+/* Why the present cannot do it, or NULL (as HDR: omacvm_edr_now). */
+static const char *omacvm_bright_no_path(void)
+{
+    const char *c = getenv("OMACVM_GL_COLOR");
+
+    if (!present_ctx) {
+        return "frames in a CAOpenGLLayer: GPU safe mode or OMACVM_GL_PRESENT=layer";
+    }
+    if (qatomic_read(&present_deep_failed)) {
+        return "half-float surfaces failed";
+    }
+    if (qatomic_read(&omacvm_bright_failed)) {
+        return "no shader";
+    }
+    if (c && !strcmp(c, "native")) {
+        return "untagged colour: OMACVM_GL_COLOR=native";
+    }
+    return NULL;
+}
+
+static void omacvm_bright_log(OmacVMBright st, int gain, double potential, const char *why)
+{
+    switch (st) {
+    case OMACVM_BRIGHT_OFF:
+        info_report("cocoa: extra brightness: off (switch off)");
+        break;
+    case OMACVM_BRIGHT_ON:
+        info_report("cocoa: extra brightness: on, %.2fx", gain / 100.0);
+        break;
+    case OMACVM_BRIGHT_HELD:
+        info_report("cocoa: extra brightness: held back by macOS, %.2fx", gain / 100.0);
+        break;
+    case OMACVM_BRIGHT_NO_DISPLAY:
+        info_report("cocoa: extra brightness: not on this display (EDR potential %.2f)",
+                    potential);
+        break;
+    case OMACVM_BRIGHT_NO_HDR:
+        info_report("cocoa: extra brightness: not with HDR yet (the guest sends PQ)");
+        break;
+    case OMACVM_BRIGHT_NO_PATH:
+        info_report("cocoa: extra brightness: off (%s)", why);
+        break;
+    }
+}
+
+static void omacvm_bright_timer_run(bool run)
+{
+    if (run && !omacvm_bright_timer) {
+        omacvm_bright_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
+                                                     dispatch_get_main_queue());
+        dispatch_source_set_timer(omacvm_bright_timer,
+                                  dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC / 4),
+                                  NSEC_PER_SEC / 4, NSEC_PER_SEC / 20);
+        dispatch_source_set_event_handler(omacvm_bright_timer, ^{
+            omacvm_bright_look();
+        });
+        dispatch_resume(omacvm_bright_timer);
+    } else if (!run && omacvm_bright_timer) {
+        dispatch_source_cancel(omacvm_bright_timer);
+        dispatch_release(omacvm_bright_timer);
+        omacvm_bright_timer = NULL;
+    }
+}
+
+/* Main thread: the switch, the window's display and the path decide; a change redraws. */
+static void omacvm_bright_look(void)
+{
+    static int hidden = -1;
+    double now = 1, potential = 1;
+
+    if (omacvm_bright_switch < 0) {
+        return;
+    }
+    if (hidden < 0) {
+        hidden = getenv("OMACVM_PRESENT_HIDDEN") != NULL;
+    }
+    bool on = omacvm_bright_switch == 1;
+    const char *why = omacvm_bright_no_path();
+    bool seen = qatomic_read(&omacvm_window_seen) || hidden;
+    if (!omacvm_bright_screen(&now, &potential)) {
+        /* No display yet: look again soon while it could be wanted. */
+        omacvm_bright_timer_run(on && !why && seen);
+        return;
+    }
+    bool pq = qatomic_read(&omacvm_bright_pq);
+    bool want = on && !why && omacvm_bright_display(potential);
+    int gain = want ? omacvm_bright_gain(now, potential) : OMACVM_BRIGHT_ONE;
+    bool was = qatomic_read(&omacvm_bright_wanted);
+    if (want != was || omacvm_bright_moved(qatomic_read(&omacvm_bright_gain_c), gain)) {
+        qatomic_set(&omacvm_bright_gain_c, gain);
+        qatomic_set(&omacvm_bright_wanted, want);
+        if (omacvm_bright_bh) {
+            qemu_bh_schedule(omacvm_bright_bh);
+        }
+    }
+
+    /* qemu.log: once per change; "held back" only once it lasted 2 s. */
+    OmacVMBright st = omacvm_bright_state(omacvm_bright_now_state, on, !why, potential, pq, gain);
+    double t = CACurrentMediaTime();
+    omacvm_bright_now_state = st;
+    if (st != OMACVM_BRIGHT_HELD || omacvm_bright_logged == OMACVM_BRIGHT_HELD) {
+        omacvm_bright_held_since = 0;
+    } else if (!omacvm_bright_held_since) {
+        omacvm_bright_held_since = t;
+    }
+    bool settling = omacvm_bright_held_since && t - omacvm_bright_held_since < 2;
+    if ((int)st != omacvm_bright_logged && !settling &&
+        !(omacvm_bright_logged < 0 && st == OMACVM_BRIGHT_OFF)) {
+        omacvm_bright_log(st, gain, potential, why);
+        omacvm_bright_logged = st;
+    }
+    omacvm_bright_timer_run(want && !pq && seen);
+}
+
+static void omacvm_bright_reread(void)
+{
+    if (omacvm_bright_switch < 0) {
+        return;
+    }
+    omacvm_bright_read_switch();
+    omacvm_bright_look();
+}

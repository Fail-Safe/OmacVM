+@interface OmacVMBrightWatch : NSObject
+@end
+
+@implementation OmacVMBrightWatch
+/* Any thread: the app's switch changed (this process or another). */
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object
+                        change:(NSDictionary *)change context:(void *)context
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        omacvm_bright_reread();
+    });
+}
+@end
+
+/* Main thread, once the GL present is chosen. */
+static void omacvm_bright_init(void)
+{
+    NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+
+    omacvm_bright_read_switch();
+    if (omacvm_bright_as_app()) {
+        static OmacVMBrightWatch *watch;
+        watch = [[OmacVMBrightWatch alloc] init];
+        [[NSUserDefaults standardUserDefaults] addObserver:watch
+                                                forKeyPath:@"extraBrightness"
+                                                   options:0
+                                                   context:NULL];
+    }
+    [nc addObserverForName:NSApplicationDidBecomeActiveNotification object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        omacvm_bright_reread();
+    }];
+    [nc addObserverForName:NSApplicationDidChangeScreenParametersNotification object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        omacvm_bright_look();
+    }];
+    omacvm_bright_look();
+}

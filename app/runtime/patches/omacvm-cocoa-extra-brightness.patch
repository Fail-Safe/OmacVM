+/*
+ * OmacVM, extra brightness (ADR 0050, ui/omacvm-bright.h): with the app's
+ * switch (extraBrightness, read live) the guest's SDR frames go through a
+ * shader into half-float surfaces in extended linear sRGB, times a gain
+ * that follows the window's display's headroom (at most 2x), and the
+ * layer shows them with EDR. Off: the frames take the plain path as
+ * before. Never for PQ frames (HDR): not with HDR yet.
+ *
+ * Threads: the main thread reads the switch and the display (a 250 ms look
+ * while the switch is on, the window is seen and its display can show it)
+ * and writes omacvm_bright_wanted and omacvm_bright_gain_c; QEMU's thread
+ * reads them when it draws (qatomic), makes the shader on present_ctx the
+ * first time and redraws the newest frame when they change
+ * (omacvm_bright_bh, in both present modes, also on a static desktop).
+ */
+static int omacvm_bright_wanted;        /* qatomic: linear surfaces for SDR frames */
+static int omacvm_bright_gain_c = OMACVM_BRIGHT_ONE;   /* qatomic: hundredths */
+static int omacvm_bright_pq;            /* qatomic: the guest's frames are PQ now */
+static int omacvm_bright_failed;        /* qatomic: the shader failed: off this run */
+static QEMUBH *omacvm_bright_bh;
+static GLuint omacvm_bright_prog, omacvm_bright_vao, omacvm_bright_vbo;
+static GLint omacvm_bright_u_gain, omacvm_bright_u_flip;
+static int omacvm_bright_made;          /* QEMU thread: 1 made, -1 failed */
+
+static GLuint omacvm_bright_shader(GLenum type, const char *src)
+{
+    GLuint s = glCreateShader(type);
+    GLint ok = 0;
+
+    glShaderSource(s, 1, &src, NULL);
+    glCompileShader(s);
+    glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char why[512] = "";
+        glGetShaderInfoLog(s, sizeof(why), NULL, why);
+        warn_report("cocoa: extra brightness: the %s shader does not compile: %s",
+                    type == GL_VERTEX_SHADER ? "vertex" : "fragment", why);
+        glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+/* QEMU thread, present_ctx current: the gain program, made once. */
+static bool omacvm_bright_program(void)
+{
+    static const GLfloat quad[] = { -1, -1, 1, -1, -1, 1, 1, 1 };
+
+    if (omacvm_bright_made) {
+        return omacvm_bright_made > 0;
+    }
+    GLuint vs = omacvm_bright_shader(GL_VERTEX_SHADER, OMACVM_BRIGHT_VERT);
+    GLuint fs = omacvm_bright_shader(GL_FRAGMENT_SHADER, OMACVM_BRIGHT_FRAG);
+    GLint ok = 0;
+    if (vs && fs) {
+        omacvm_bright_prog = glCreateProgram();
+        glAttachShader(omacvm_bright_prog, vs);
+        glAttachShader(omacvm_bright_prog, fs);
+        glBindAttribLocation(omacvm_bright_prog, 0, "in_position");
+        glLinkProgram(omacvm_bright_prog);
+        glGetProgramiv(omacvm_bright_prog, GL_LINK_STATUS, &ok);
+    }
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    if (!ok) {
+        if (omacvm_bright_prog) {
+            glDeleteProgram(omacvm_bright_prog);
+            omacvm_bright_prog = 0;
+        }
+        omacvm_bright_made = -1;
+        qatomic_set(&omacvm_bright_failed, 1);
+        warn_report("cocoa: extra brightness: no shader, off for this run");
+        dispatch_async(dispatch_get_main_queue(), ^{
+            omacvm_bright_look();
+        });
+        return false;
+    }
+    glUseProgram(omacvm_bright_prog);
+    glUniform1i(glGetUniformLocation(omacvm_bright_prog, "image"), 0);
+    omacvm_bright_u_gain = glGetUniformLocation(omacvm_bright_prog, "gain");
+    omacvm_bright_u_flip = glGetUniformLocation(omacvm_bright_prog, "yflip");
+    glGenVertexArrays(1, &omacvm_bright_vao);
+    glBindVertexArray(omacvm_bright_vao);
+    glGenBuffers(1, &omacvm_bright_vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, omacvm_bright_vbo);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, 0);
+    glEnableVertexAttribArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindVertexArray(0);
+    omacvm_bright_made = 1;
+    return true;
+}
+
+/*
+ * QEMU thread, present_ctx current: the bound texture into the bound
+ * framebuffer as QEMU's blit (flip as its texture_blit_flip), decoded to
+ * linear light and times gain (hundredths). False without the program.
+ */
+static bool omacvm_bright_blit(bool flip, int gain)
+{
+    if (omacvm_bright_made <= 0) {
+        return false;
+    }
+    glUseProgram(omacvm_bright_prog);
+    glUniform1f(omacvm_bright_u_gain, gain / 100.0f);
+    glUniform1f(omacvm_bright_u_flip, flip ? 1.0f : -1.0f);
+    glBindVertexArray(omacvm_bright_vao);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glBindVertexArray(0);
+    return true;
+}
+
+/* QEMU thread, BQL held: the switch or the gain changed: the newest frame again. */
+static void omacvm_bright_redraw(void *opaque)
+{
+    gl_dirty = true;
+    cocoa_gl_present_request();
+}
 

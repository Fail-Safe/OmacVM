From: OmacVM
Subject: [PATCH] cocoa: the window's 8-bit surfaces lossless-compressed (fewer bytes per frame)

What: the IOSurface present makes its 8-bit surfaces in Apple's
lossless-compressed BGRA ('&BGA', kCVPixelFormatType_Lossless_32BGRA,
through CoreVideo) instead of plain 'BGRA'. The GPU writes and reads them
compressed: QEMU's draw of each frame into the surface and WindowServer's
composite of the window move fewer bytes. Nothing reads these surfaces on
the CPU (the boot logo's readback reads the guest's texture). Half-float
surfaces (HDR, Extra brightness) stay as they are. If one cannot be made
or bound to GL, every surface is plain 'BGRA' for the rest of the run (one
warning in qemu.log); OMACVM_GL_LOSSLESS=0 keeps them plain. qemu.log says
"cocoa: 8-bit surfaces lossless-compressed" (or plain) when it changes.

Why: what showing the VM's window costs is mostly moving its pixels, not
GPU time (taking WindowServer's colour matching out of its composite took
a third off its GPU time and nothing off the watts). MacBook Air M2, the
real VM full screen at 60 Hz, A/B/A/B: scrolling 4.45 W vs 4.65 W plain
(-0.20 W, -4 %), a 1080p30 video the same within the gauge's noise; the
same pixels (a 144-patch page: all identical) and frame rates. QEMU's own
draw: 20-25 % less GPU time. GL draws into these surfaces exactly (read
back through Core Image on an M1 Max, an M2 and an M4:
work/window-path/lbcheck.m).

Upstream: OmacVM only (QEMU's IOSurface present is OmacVM's).
Test: app/runtime/Tests/display/test-present-lossless.sh (the patched
ui/cocoa.m is wired as tested; the checks catch code without it).
Applies after omacvm-cocoa-extra-brightness.patch (before omacvm-cocoa-no-app-nap.patch).
diff --git a/ui/cocoa.m b/ui/cocoa.m
index 1ecf9d4..9a32c1b 100644
--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -7432,6 +7432,18 @@ static void cocoa_gl_render(void)
 static uint32_t present_w, present_h;
 static bool present_deep;              /* half-float surfaces (10-bit scanout) */
 static bool present_linear;            /* half-float, extended linear sRGB: extra brightness */
+static bool present_packed;            /* 8-bit surfaces in lossless-compressed BGRA */
+
+/*
+ * OmacVM, lossless surfaces: the 8-bit surfaces in Apple's lossless-
+ * compressed BGRA ('&BGA', made through CoreVideo). The GPU writes and
+ * reads them compressed, so QEMU's draw into them and WindowServer's
+ * composite of the window move fewer bytes. Nothing reads them on the CPU
+ * (the boot logo's readback reads the guest's texture). If one cannot be
+ * made or bound, every surface is plain 'BGRA' for the rest of the run;
+ * OMACVM_GL_LOSSLESS=0 keeps them plain.
+ */
+static int present_lossless = -1;      /* -1 not read yet, 0 plain, 1 lossless */
 
 /*
  * Colour. The guest renders sRGB unless it says otherwise, so the surfaces
@@ -7913,6 +7925,24 @@ static void omacvm_present_gravity(CALayer *layer, IOSurfaceRef surf)
     }
 }
 
+/* A w x h lossless-compressed BGRA surface, or NULL. */
+static IOSurfaceRef cocoa_gl_present_packed(uint32_t w, uint32_t h)
+{
+    CVPixelBufferRef pb = NULL;
+    IOSurfaceRef surf = NULL;
+    NSDictionary *attrs = @{ (id)kCVPixelBufferIOSurfacePropertiesKey: @{} };
+
+    if (CVPixelBufferCreate(kCFAllocatorDefault, w, h, kCVPixelFormatType_Lossless_32BGRA,
+                            (CFDictionaryRef)attrs, &pb) == kCVReturnSuccess && pb) {
+        surf = CVPixelBufferGetIOSurface(pb);
+        if (surf) {
+            CFRetain(surf);
+        }
+        CVPixelBufferRelease(pb);
+    }
+    return surf;
+}
+
 /*
  * present_ctx is current. Surfaces for a w x h frame, capped at the
  * largest display. Made again at most every PRESENT_REALLOC_NS: until
@@ -7964,6 +7994,15 @@ static bool cocoa_gl_present_alloc(uint32_t w, uint32_t h, bool deep, bool linea
     present_alloc_ns = now;
     present_realloc_due = false;
 
+    if (present_lossless < 0) {
+        const char *e = getenv("OMACVM_GL_LOSSLESS");
+        present_lossless = !(e && (!strcmp(e, "0") || !strcmp(e, "off")));
+        if (!present_lossless) {
+            info_report("cocoa: lossless surfaces: off (OMACVM_GL_LOSSLESS)");
+        }
+    }
+again:;
+    bool packed = !half && present_lossless == 1;
     NSDictionary *props = @{
         (id)kIOSurfaceWidth: @(w),
         (id)kIOSurfaceHeight: @(h),
@@ -7974,7 +8013,8 @@ static bool cocoa_gl_present_alloc(uint32_t w, uint32_t h, bool deep, bool linea
     CFPropertyListRef cs_plist = cs ? CGColorSpaceCopyPropertyList(cs) : NULL;
     bool ok = true;
     for (int i = 0; i < present_nsurf && ok; i++) {
-        present_surf[i] = IOSurfaceCreate((CFDictionaryRef)props);
+        present_surf[i] = packed ? cocoa_gl_present_packed(w, h) :
+                                   IOSurfaceCreate((CFDictionaryRef)props);
         if (!present_surf[i]) {
             ok = false;
             break;
@@ -8004,10 +8044,20 @@ static bool cocoa_gl_present_alloc(uint32_t w, uint32_t h, bool deep, bool linea
     }
     CGColorSpaceRelease(cs);
     glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+    if (!ok && packed) {
+        cocoa_gl_present_free();
+        present_lossless = 0;
+        warn_report("cocoa: lossless surfaces failed, plain 8-bit surfaces from now on");
+        goto again;
+    }
     if (!ok) {
         cocoa_gl_present_free();
         return false;
     }
+    if (packed != present_packed) {
+        info_report("cocoa: 8-bit surfaces %s", packed ? "lossless-compressed" : "plain");
+    }
+    present_packed = packed;
     present_w = w;
     present_h = h;
     present_deep = deep;

+
+/* OmacVM: gallium's constant buffer 0 bound as a guest buffer (SET_UNIFORM_BUFFER index 0:
+ * Mesa's VA-API video compositor binds its colour matrix that way) holds the stage's plain
+ * constants, CONST[0..n], which vrend took only from SET_CONSTANT_BUFFER: the shader read
+ * zeros, and every frame VA-API converted to RGB was black. For each draw (the guest writes
+ * new ones into the same buffer) its bytes become the stage's constants, as many as the
+ * shader declares; past the buffer's range they read as zero. Where the constants are a
+ * uniform block bound per draw, the GPU copies them into the stage's own buffer (no wait for
+ * the GPU); else (uniforms, a vertex window) they are read back. GLES has no
+ * glGetBufferSubData: unchanged there. */
+static void vrend_const0_from_buffer(struct vrend_sub_context *sub_ctx, int shader_type)
+{
+   const struct pipe_constant_buffer *cb = &sub_ctx->cbs[shader_type][0];
+   const struct vrend_resource *res = (const struct vrend_resource *)cb->buffer;
+   const struct vrend_shader_selector *sel = sub_ctx->shaders[shader_type];
+   struct vrend_constants *consts = &sub_ctx->consts[shader_type];
+   uint32_t words, bytes;
 
+   if (!sel || !sel->sinfo.num_consts || vrend_state.use_gles || !vrend_res_is_gl_buffer(res))
+      return;
+   words = sel->sinfo.num_consts * 4;
+   bytes = MIN2(cb->buffer_size, words * 4);
+   if (!vrend_buffer_range_ok(res, cb->buffer_offset, bytes))
+      return;
+   if (sub_ctx->prog->const_block_bind[shader_type] &&
+       !(shader_type == PIPE_SHADER_VERTEX && sub_ctx->prog->const_index)) {
+      static const uint8_t zeros[4096];
+      uint32_t size = sub_ctx->prog->const_block_size[shader_type];
+      uint32_t copy = MIN2(bytes, size);
+
+      if (!sub_ctx->const_own[shader_type])
+         glGenBuffers(1, &sub_ctx->const_own[shader_type]);
+      glBindBuffer(GL_UNIFORM_BUFFER, sub_ctx->const_own[shader_type]);
+      glBufferData(GL_UNIFORM_BUFFER, size, NULL, GL_STREAM_DRAW);
+      for (uint32_t at = copy; at < size; at += sizeof(zeros))
+         glBufferSubData(GL_UNIFORM_BUFFER, at, MIN2(sizeof(zeros), size - at), zeros);
+      glBindBuffer(GL_UNIFORM_BUFFER, 0);
+      if (copy) {
+         glBindBuffer(GL_COPY_READ_BUFFER, res->gl_id);
+         glBindBuffer(GL_COPY_WRITE_BUFFER, sub_ctx->const_own[shader_type]);
+         glCopyBufferSubData(GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, cb->buffer_offset, 0, copy);
+         glBindBuffer(GL_COPY_READ_BUFFER, 0);
+         glBindBuffer(GL_COPY_WRITE_BUFFER, 0);
+      }
+      sub_ctx->const_own_size[shader_type] = size;
+      consts->ubo_ok = true;
+      consts->ubo_id = sub_ctx->const_own[shader_type];
+      consts->ubo_offset = 0;
+      consts->ubo_bytes = size;
+      consts->ubo_slot = VREND_CONST_RING;
+      consts->ubo_gen = 0;
+      return;
+   }
+   if (consts->num_allocated_consts < words) {
+      unsigned int *grown = malloc(words * sizeof(*grown));
+      if (!grown)
+         return;
+      free(consts->consts);
+      consts->consts = grown;
+      consts->num_allocated_consts = words;
+   }
+   memset(consts->consts, 0, words * sizeof(*consts->consts));
+   glBindBuffer(GL_COPY_READ_BUFFER, res->gl_id);
+   glGetBufferSubData(GL_COPY_READ_BUFFER, cb->buffer_offset, bytes, consts->consts);
+   glBindBuffer(GL_COPY_READ_BUFFER, 0);
+   consts->num_consts = words;
+   /* not the submit's upload: the draw puts them into the stage's own buffer */
+   consts->ubo_ok = false;
+   consts->ubo_slot = VREND_CONST_RING;
+   sub_ctx->const_dirty[shader_type] = true;
+}
+
 static void vrend_draw_bind_const_shader(struct vrend_sub_context *sub_ctx,
                                          int shader_type, bool new_program)
 {
+   if (sub_ctx->const0_buffer[shader_type])
+      vrend_const0_from_buffer(sub_ctx, shader_type);
    if (sub_ctx->prog->const_block_bind[shader_type]) {
       vrend_draw_bind_const_block(sub_ctx, shader_type);
       return;
